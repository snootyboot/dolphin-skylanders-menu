+using Category = SkylanderQuickMenu::Category;
+
+const char* CategoryTitle(Category category)
+{
+  switch (category)
+  {
+  case Category::Magic:
+    return "Magic";
+  case Category::Fire:
+    return "Fire";
+  case Category::Air:
+    return "Air";
+  case Category::Life:
+    return "Life";
+  case Category::Undead:
+    return "Undead";
+  case Category::Earth:
+    return "Earth";
+  case Category::Water:
+    return "Water";
+  case Category::Tech:
+    return "Tech";
+  case Category::Dark:
+    return "Dark";
+  case Category::Light:
+    return "Light";
+  case Category::Sidekick:
+    return "Sidekicks";
+  case Category::Item:
+    return "Magic items and adventures";
+  case Category::Trap:
+    return "Traps";
+  default:
+    return "Other";
+  }
+}
+
+bool IsRecentCategory(Category category)
+{
+  return category <= Category::Sidekick;
+}
+
+std::string Initials(const std::string& name)
+{
+  std::string result;
+  bool word_start = true;
+  for (const char c : name)
+  {
+    const bool alnum = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
+    if (alnum && word_start)
+    {
+      result += c;
+      if (result.size() == 2)
+        break;
+    }
+    word_start = !alnum;
+  }
+  if (result.size() == 1 && name.size() > 1)
+    result += name[1];
+  return result;
+}
+
+// Nearest-neighbour shrink so huge photos don't become huge textures.
+void ShrinkRGBA(Common::UniqueBuffer<u8>* data, u32* width, u32* height)
+{
+  const u32 largest = std::max(*width, *height);
+  if (largest <= MAX_PORTRAIT_SIZE)
+    return;
+
+  const u32 new_w = std::max(1u, *width * MAX_PORTRAIT_SIZE / largest);
+  const u32 new_h = std::max(1u, *height * MAX_PORTRAIT_SIZE / largest);
+  Common::UniqueBuffer<u8> out(size_t{new_w} * new_h * 4);
+  for (u32 y = 0; y < new_h; ++y)
+  {
+    const u32 src_y = y * *height / new_h;
+    for (u32 x = 0; x < new_w; ++x)
+    {
+      const u32 src_x = x * *width / new_w;
+      std::copy_n(data->data() + (size_t{src_y} * *width + src_x) * 4, 4,
+                  out.data() + (size_t{y} * new_w + x) * 4);
+    }
+  }
+  *data = std::move(out);
+  *width = new_w;
+  *height = new_h;
+}
