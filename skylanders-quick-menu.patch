+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+class AbstractTexture;
+
+namespace VideoCommon
+{
+// In-game, controller-driven menu for placing Skylanders on the emulated Portal of Power.
+// Input is fed in from the hotkey thread, the figure list and slot contents are fed in from
+// the UI thread, and the menu is drawn on the video thread as part of the on-screen UI.
+class SkylanderQuickMenu
+{
+public:
+  // Slots 0 and 1 hold characters/sidekicks; slot 2 holds magic items, adventure packs and traps.
+  static constexpr int NUM_SLOTS = 3;
+  static constexpr int ITEM_SLOT = 2;
+
+  // Display order of the groups below the Recent row.
+  enum class Category
+  {
+    Magic,
+    Fire,
+    Air,
+    Life,
+    Undead,
+    Earth,
+    Water,
+    Tech,
+    Dark,
+    Light,
+    Sidekick,
+    Item,
+    Trap,
+    Other,
+    Count
+  };
+
+  struct Entry
+  {
+    std::string name;
+    std::string path;
+    std::string image_path;  // PNG portrait, or empty for an initials tile
+    u32 color = 0xFFFFFFFF;  // ImGui ABGR
+    Category category = Category::Other;
+    s64 last_used = 0;  // Unix seconds, 0 = never
+    // No file yet: one will be created in the collection folder when it's first placed.
+    bool is_new = false;
+  };
+
+  enum class ActionType
+  {
+    None,
+    Place,
+    Remove,
+  };
+
+  struct Action
+  {
+    ActionType type = ActionType::None;
+    int slot = 0;
+    std::string path;
+  };
+
+  static SkylanderQuickMenu& GetInstance();
+
+  void Open();
+  void Close();
+  bool IsOpen() const { return m_open.load(std::memory_order_relaxed); }
+
+  // UI thread
+  void SetEntries(std::vector<Entry> entries);
+  void SetSlotContents(int slot, std::string name, std::string path);
+
+  // Hotkey thread
+  void MoveCursor(int dx, int dy);
+  void SwitchSlot(int delta);
+  Action Confirm();
+  Action RemoveFromSlot();
+
+  // Video thread, between ImGui::NewFrame and ImGui::Render
+  void Display();
+  // Video thread, before the graphics backend goes away
+  void ReleaseTextures();
+
+private:
+  struct SlotContents
+  {
+    std::string name;
+    std::string path;
+  };
+
+  struct Row
+  {
+    int section = 0;
+    bool first_in_section = false;
+    std::vector<int> entries;  // indices into m_entries
+  };
+
+  SkylanderQuickMenu();
+  ~SkylanderQuickMenu();
+
+  void RebuildLayout(bool keep_cursor_entry);
+  void PlaceCursorOnPath(const std::string& path);
+  int CursorEntry() const;
+  AbstractTexture* GetTexture(const std::string& path, int* loads_left);
+
+  mutable std::mutex m_mutex;
+  std::atomic<bool> m_open{false};
+  std::vector<Entry> m_entries;
+  std::array<SlotContents, NUM_SLOTS> m_slots;
+  int m_selected_slot = 0;
+
+  std::vector<std::string> m_section_titles;
+  std::vector<Row> m_rows;
+  int m_cursor_row = 0;
+  int m_cursor_col = 0;
+  bool m_scroll_to_cursor = false;
+  bool m_place_cursor_pending = false;
+
+  // Video thread only. A null texture marks an image that failed to load.
+  std::map<std::string, std::unique_ptr<AbstractTexture>> m_textures;
+};
+}  // namespace VideoCommon
