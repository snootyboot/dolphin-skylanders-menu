+// In-game quick menu
+
+static u32 QuickMenuElementColor(std::pair<u16, u16> ids)
+{
+  // ImGui packs colors as ABGR.
+  constexpr auto rgb = [](u32 r, u32 g, u32 b) { return 0xFF000000u | (b << 16) | (g << 8) | r; };
+
+  const auto found = IOS::HLE::USB::list_skylanders.find(ids);
+  if (found == IOS::HLE::USB::list_skylanders.end())
+    return rgb(140, 140, 140);
+
+  switch (found->second.element)
+  {
+  case Element::Magic:
+    return rgb(170, 90, 230);
+  case Element::Fire:
+    return rgb(240, 80, 40);
+  case Element::Air:
+    return rgb(140, 210, 255);
+  case Element::Life:
+    return rgb(90, 200, 60);
+  case Element::Undead:
+    return rgb(120, 110, 150);
+  case Element::Earth:
+    return rgb(170, 110, 50);
+  case Element::Water:
+    return rgb(40, 110, 240);
+  case Element::Tech:
+    return rgb(250, 190, 30);
+  case Element::Dark:
+    return rgb(70, 50, 90);
+  case Element::Light:
+    return rgb(255, 245, 170);
+  default:
+    return rgb(140, 140, 140);
+  }
+}
+
+static VideoCommon::SkylanderQuickMenu::Category QuickMenuCategory(std::pair<u16, u16> ids)
+{
+  using Category = VideoCommon::SkylanderQuickMenu::Category;
+  const auto found = IOS::HLE::USB::list_skylanders.find(ids);
+  if (found == IOS::HLE::USB::list_skylanders.end())
+    return Category::Other;
+
+  switch (found->second.type)
+  {
+  case Type::Mini:
+    return Category::Sidekick;
+  case Type::Item:
+    return Category::Item;
+  case Type::Trap:
+    return Category::Trap;
+  case Type::Trophy:
+  case Type::Unknown:
+    return Category::Other;
+  default:
+    break;
+  }
+
+  switch (found->second.element)
+  {
+  case Element::Magic:
+    return Category::Magic;
+  case Element::Fire:
+    return Category::Fire;
+  case Element::Air:
+    return Category::Air;
+  case Element::Life:
+    return Category::Life;
+  case Element::Undead:
+    return Category::Undead;
+  case Element::Earth:
+    return Category::Earth;
+  case Element::Water:
+    return Category::Water;
+  case Element::Tech:
+    return Category::Tech;
+  case Element::Dark:
+    return Category::Dark;
+  case Element::Light:
+    return Category::Light;
+  default:
+    return Category::Other;
+  }
+}
