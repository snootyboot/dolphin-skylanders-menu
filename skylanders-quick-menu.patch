+// Each line: <unix seconds><tab><file name>
+std::map<QString, s64> SkylanderPortalWindow::LoadQuickMenuRecent() const
+{
+  std::map<QString, s64> recent;
+  std::string contents;
+  if (!File::ReadFileToString(QuickMenuRecentFile().toStdString(), contents))
+    return recent;
+
+  for (const QString& line : QString::fromStdString(contents).split(QLatin1Char('\n')))
+  {
+    const qsizetype tab = line.indexOf(QLatin1Char('\t'));
+    if (tab <= 0)
+      continue;
+    bool ok = false;
+    const s64 when = line.left(tab).toLongLong(&ok);
+    const QString name = line.mid(tab + 1).trimmed();
+    if (ok && !name.isEmpty())
+      recent[name] = when;
+  }
+  return recent;
+}
+
+void SkylanderPortalWindow::RecordQuickMenuUse(const QString& path) const
+{
+  auto recent = LoadQuickMenuRecent();
+  recent[QFileInfo(path).fileName()] = QDateTime::currentSecsSinceEpoch();
+
+  std::string contents;
+  for (const auto& [name, when] : recent)
+    contents += fmt::format("{}\t{}\n", when, name.toStdString());
+  File::WriteStringToFile(QuickMenuRecentFile().toStdString(), contents);
+}
+
+void SkylanderPortalWindow::QuickMenuPublishEntries()
+{
+  using Entry = VideoCommon::SkylanderQuickMenu::Entry;
+  std::vector<Entry> entries;
+  std::set<std::pair<u16, u16>> owned;
+
+  const QDir collection(m_collection_path);
+  const QDir portraits(collection.filePath(QStringLiteral("Portraits")));
+  const auto recent = LoadQuickMenuRecent();
+
+  const auto make_entry = [&](const QString& name, const QString& path, std::pair<u16, u16> ids,
+                              bool is_new) {
+    Entry entry;
+    entry.name = name.toStdString();
+    entry.path = path.toStdString();
+    const QString image = portraits.filePath(name + QStringLiteral(".png"));
+    if (QFileInfo::exists(image))
+      entry.image_path = image.toStdString();
+    entry.color = QuickMenuElementColor(ids);
+    entry.category = QuickMenuCategory(ids);
+    if (const auto it = recent.find(QFileInfo(path).fileName()); it != recent.end())
+      entry.last_used = it->second;
+    entry.is_new = is_new;
+    return entry;
+  };
+
+  auto& system = Core::System::GetInstance();
+  for (const QFileInfo& file :
+       collection.entryInfoList({QStringLiteral("*.sky"), QStringLiteral("*.bin"),
+                                 QStringLiteral("*.dmp"), QStringLiteral("*.dump")},
+                                QDir::Files))
+  {
+    File::IOFile sky_file(file.filePath().toStdString(), "rb");
+    std::array<u8, 0x40 * 0x10> file_data;
+    if (!sky_file || !sky_file.ReadBytes(file_data.data(), file_data.size()))
+      continue;
+
+    const auto ids = system.GetSkylanderPortal().CalculateIDs(file_data);
+    owned.insert(ids);
+    entries.push_back(make_entry(file.completeBaseName(), file.absoluteFilePath(), ids, false));
+  }
+
+  // Every Spyro's Adventure figure without a file yet.
+  m_quick_menu_new_files.clear();
+  for (const auto& [ids, sky_data] : IOS::HLE::USB::list_skylanders)
+  {
+    if (sky_data.game != Game::SpyrosAdv || owned.contains(ids))
+      continue;
+
+    const QString name = QString::fromUtf8(sky_data.name);
+    const QString path =
+        QFileInfo(collection.filePath(name + QStringLiteral(".sky"))).absoluteFilePath();
+    if (QFileInfo::exists(path))
+      continue;  // A file with this name exists but holds a different figure; leave it alone.
+
+    m_quick_menu_new_files[path] = ids;
+    entries.push_back(make_entry(name, path, ids, true));
+  }
+
+  std::ranges::sort(entries, [](const Entry& a, const Entry& b) {
+    return QString::fromStdString(a.name).compare(QString::fromStdString(b.name),
+                                                  Qt::CaseInsensitive) < 0;
+  });
+
+  PublishQuickMenuSlots();
+  VideoCommon::SkylanderQuickMenu::GetInstance().SetEntries(std::move(entries));
+}
+
+void SkylanderPortalWindow::PublishQuickMenuSlots() const
+{
+  auto& menu = VideoCommon::SkylanderQuickMenu::GetInstance();
+  for (int i = 0; i < VideoCommon::SkylanderQuickMenu::NUM_SLOTS; ++i)
+  {
+    const auto& slot = m_sky_slots[i];
+    if (!slot)
+    {
+      menu.SetSlotContents(i, {}, {});
+      continue;
+    }
+
+    std::string name;
+    if (!slot->path.isEmpty())
+    {
+      name = QFileInfo(slot->path).completeBaseName().toStdString();
+    }
+    else
+    {
+      const auto found =
+          IOS::HLE::USB::list_skylanders.find(std::make_pair(slot->m_sky_id, slot->m_sky_var));
+      name = found != IOS::HLE::USB::list_skylanders.end() ? found->second.name : "Unknown";
+    }
+    menu.SetSlotContents(i, std::move(name), slot->path.toStdString());
+  }
+}
+
+void SkylanderPortalWindow::QuickMenuPlace(u8 slot, const QString& path)
+{
+  const QString absolute_path = QFileInfo(path).absoluteFilePath();
+  m_quiet = true;
+
+  // A figure can only be on the portal once: if it's in another slot, move it.
+  for (u8 i = 0; i < MAX_SKYLANDERS; ++i)
+  {
+    if (i != slot && m_sky_slots[i] && m_sky_slots[i]->path == absolute_path)
+      ClearSlot(i);
+  }
+
+  // First use of a figure we don't have a file for: create it in the collection folder.
+  if (!QFileInfo::exists(absolute_path))
+  {
+    const auto pending = m_quick_menu_new_files.find(absolute_path);
+    if (pending == m_quick_menu_new_files.end())
+    {
+      m_quiet = false;
+      return;
+    }
+
+    IOS::HLE::USB::SkylanderFigure figure(absolute_path.toStdString());
+    if (!figure.Create(pending->second.first, pending->second.second))
+    {
+      ShowWarning(tr("Failed to create Skylander file!"), absolute_path);
+      m_quiet = false;
+      return;
+    }
+    figure.Close();
+    m_quick_menu_new_files.erase(pending);
+    OSD::AddMessage(fmt::format("Created {}",
+                                QFileInfo(absolute_path).completeBaseName().toStdString()),
+                    OSD::Duration::SHORT, OSD::Color::CYAN);
+  }
+
+  LoadSkyfilePath(slot, absolute_path);
+  m_quiet = false;
+
+  if (m_sky_slots[slot] && m_sky_slots[slot]->path == absolute_path)
+  {
+    RecordQuickMenuUse(absolute_path);
+    OSD::AddMessage(fmt::format("Slot {}: {}", slot + 1,
+                                QFileInfo(absolute_path).completeBaseName().toStdString()),
+                    OSD::Duration::SHORT, OSD::Color::GREEN);
+  }
+}
+
+void SkylanderPortalWindow::QuickMenuClear(u8 slot)
+{
+  if (!m_sky_slots[slot])
+    return;
+
+  m_quiet = true;
+  ClearSlot(slot);
+  m_quiet = false;
+
+  if (!m_sky_slots[slot])
+    OSD::AddMessage(fmt::format("Slot {}: removed", slot + 1), OSD::Duration::SHORT,
+                    OSD::Color::GREEN);
 }
 
