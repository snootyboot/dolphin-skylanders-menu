+
+void HotkeyScheduler::HandleSkylanderQuickMenu(bool emulation_running)
+{
+  using SteadyClock = std::chrono::steady_clock;
+  using namespace std::chrono_literals;
+  auto& menu = VideoCommon::SkylanderQuickMenu::GetInstance();
+
+  // Read every edge-triggered key on every pass, so a press made while the menu is closed
+  // (e.g. jumping with Cross) can't register as a fresh press the moment it opens.
+  const bool toggle = IsHotkey(HK_SKYLANDERS_QUICK_MENU);
+  const bool select = IsHotkey(HK_SKYLANDERS_MENU_SELECT);
+  const bool back = IsHotkey(HK_SKYLANDERS_MENU_BACK);
+  const bool left = IsHotkey(HK_SKYLANDERS_MENU_LEFT);
+  const bool right = IsHotkey(HK_SKYLANDERS_MENU_RIGHT);
+
+  const auto repeat = [](bool down, RepeatState& state) {
+    if (!down)
+    {
+      state.held = false;
+      return false;
+    }
+    const auto now = SteadyClock::now();
+    if (!state.held)
+    {
+      state.held = true;
+      state.next = now + 400ms;
+      return true;
+    }
+    if (now >= state.next)
+    {
+      state.next = now + 110ms;
+      return true;
+    }
+    return false;
+  };
+  const bool up = repeat(IsHotkey(HK_SKYLANDERS_MENU_UP, true), m_quick_menu_up_repeat);
+  const bool down = repeat(IsHotkey(HK_SKYLANDERS_MENU_DOWN, true), m_quick_menu_down_repeat);
+
+  if (!menu.IsOpen())
+  {
+    if (m_quick_menu_release_pending &&
+        !(IsHotkey(HK_SKYLANDERS_MENU_SELECT, true) || IsHotkey(HK_SKYLANDERS_MENU_BACK, true) ||
+          IsHotkey(HK_SKYLANDERS_QUICK_MENU, true)))
+    {
+      m_quick_menu_release_pending = false;
+      Core::SetGameInputBlocked(false);
+    }
+
+    if (!toggle || !emulation_running)
+      return;
+
+    if (!Config::Get(Config::MAIN_EMULATE_SKYLANDER_PORTAL))
+    {
+      OSD::AddMessage("Skylanders: turn on the emulated portal first "
+                      "(Tools > Emulated Skylanders Portal), then restart the game.",
+                      OSD::Duration::NORMAL);
+      return;
+    }
+
+    Core::SetGameInputBlocked(true);
+    m_quick_menu_release_pending = false;
+    emit SkylanderQuickMenuOpened();
+    menu.Open();
+    return;
+  }
+
+  if (!emulation_running || toggle || back)
+  {
+    CloseSkylanderQuickMenu();
+    return;
+  }
+
+  if (select)
+  {
+    const auto action = menu.Confirm();
+    CloseSkylanderQuickMenu();
+    using ActionType = VideoCommon::SkylanderQuickMenu::ActionType;
+    if (action.type == ActionType::Place)
+      emit SkylanderQuickMenuAction(action.slot, QString::fromStdString(action.path));
+    else if (action.type == ActionType::Remove)
+      emit SkylanderQuickMenuAction(action.slot, QString());
+    return;
+  }
+
+  if (up)
+    menu.MoveCursor(-1);
+  if (down)
+    menu.MoveCursor(1);
+  if (left)
+    menu.SwitchSlot(-1);
+  if (right)
+    menu.SwitchSlot(1);
+}
