+SkylanderQuickMenu& SkylanderQuickMenu::GetInstance()
+{
+  static SkylanderQuickMenu instance;
+  return instance;
+}
+
+SkylanderQuickMenu::SkylanderQuickMenu() = default;
+
+SkylanderQuickMenu::~SkylanderQuickMenu()
+{
+  // Textures should have been released with the video backend. If not, it's gone by now, so
+  // deliberately leak rather than free GPU objects into a dead backend at exit.
+  for (auto& texture : m_textures)
+    static_cast<void>(texture.second.release());
+}
+
+void SkylanderQuickMenu::Open()
+{
+  std::lock_guard lk(m_mutex);
+  RebuildLayout(false);
+  PlaceCursorOnPath(m_slots[m_selected_slot].path);
+  m_place_cursor_pending = true;
+  m_open.store(true, std::memory_order_relaxed);
+}
+
+void SkylanderQuickMenu::Close()
+{
+  m_open.store(false, std::memory_order_relaxed);
+}
+
+void SkylanderQuickMenu::SetEntries(std::vector<Entry> entries)
+{
+  std::lock_guard lk(m_mutex);
+  m_entries = std::move(entries);
+  RebuildLayout(!m_place_cursor_pending);
+  if (m_place_cursor_pending)
+  {
+    PlaceCursorOnPath(m_slots[m_selected_slot].path);
+    m_place_cursor_pending = false;
+  }
+}
+
+void SkylanderQuickMenu::SetSlotContents(int slot, std::string name, std::string path)
+{
+  if (slot < 0 || slot >= NUM_SLOTS)
+    return;
+
+  std::lock_guard lk(m_mutex);
+  m_slots[slot] = {std::move(name), std::move(path)};
+}
+
+void SkylanderQuickMenu::RebuildLayout(bool keep_cursor_entry)
+{
+  std::string keep_path;
+  if (keep_cursor_entry)
+  {
+    if (const int index = CursorEntry(); index >= 0)
+      keep_path = m_entries[index].path;
+  }
+
+  m_rows.clear();
+  m_section_titles.clear();
+
+  const auto add_section = [this](const char* title, const std::vector<int>& indices) {
+    if (indices.empty())
+      return;
+    const int section = static_cast<int>(m_section_titles.size());
+    m_section_titles.emplace_back(title);
+    for (size_t i = 0; i < indices.size(); i += COLUMNS)
+    {
+      Row row;
+      row.section = section;
+      row.first_in_section = i == 0;
+      const size_t end = std::min(indices.size(), i + COLUMNS);
+      row.entries.assign(indices.begin() + static_cast<std::ptrdiff_t>(i),
+                         indices.begin() + static_cast<std::ptrdiff_t>(end));
+      m_rows.push_back(std::move(row));
+    }
+  };
+
+  const auto indices_in = [this](Category category) {
+    std::vector<int> indices;
+    for (int i = 0; i < static_cast<int>(m_entries.size()); ++i)
+    {
+      if (m_entries[i].category == category)
+        indices.push_back(i);
+    }
+    return indices;
+  };
+
+  if (m_selected_slot == ITEM_SLOT)
+  {
+    add_section(CategoryTitle(Category::Item), indices_in(Category::Item));
+    add_section(CategoryTitle(Category::Trap), indices_in(Category::Trap));
+  }
+  else
+  {
+    // Recent: the most recently used figure of each element, plus the most recent sidekick.
+    std::array<int, static_cast<size_t>(Category::Count)> newest;
+    newest.fill(-1);
+    for (int i = 0; i < static_cast<int>(m_entries.size()); ++i)
+    {
+      const Entry& entry = m_entries[i];
+      if (entry.last_used <= 0 || !IsRecentCategory(entry.category))
+        continue;
+      int& best = newest[static_cast<size_t>(entry.category)];
+      if (best < 0 || m_entries[best].last_used < entry.last_used)
+        best = i;
+    }
+    std::vector<int> recent;
+    for (const int index : newest)
+    {
+      if (index >= 0)
+        recent.push_back(index);
+    }
+    std::ranges::sort(recent, [this](int a, int b) {
+      return m_entries[a].last_used > m_entries[b].last_used;
+    });
+    if (recent.size() > MAX_RECENT)
+      recent.resize(MAX_RECENT);
+    add_section("Recent", recent);
+
+    for (int c = 0; c < static_cast<int>(Category::Count); ++c)
+    {
+      const auto category = static_cast<Category>(c);
+      if (category != Category::Item && category != Category::Trap)
+        add_section(CategoryTitle(category), indices_in(category));
+    }
+  }
+
+  m_cursor_row = 0;
+  m_cursor_col = 0;
+  if (!keep_path.empty())
+    PlaceCursorOnPath(keep_path);
+  m_scroll_to_cursor = true;
+}
+
+void SkylanderQuickMenu::PlaceCursorOnPath(const std::string& path)
+{
+  m_cursor_row = 0;
+  m_cursor_col = 0;
+  m_scroll_to_cursor = true;
+  if (path.empty())
+    return;
+
+  for (int r = 0; r < static_cast<int>(m_rows.size()); ++r)
+  {
+    const auto& row_entries = m_rows[r].entries;
+    for (int c = 0; c < static_cast<int>(row_entries.size()); ++c)
+    {
+      if (m_entries[row_entries[c]].path == path)
+      {
+        m_cursor_row = r;
+        m_cursor_col = c;
+        return;
+      }
+    }
+  }
+}
+
+int SkylanderQuickMenu::CursorEntry() const
+{
+  if (m_cursor_row < 0 || m_cursor_row >= static_cast<int>(m_rows.size()))
+    return -1;
+  const auto& row_entries = m_rows[m_cursor_row].entries;
+  if (m_cursor_col < 0 || m_cursor_col >= static_cast<int>(row_entries.size()))
+    return -1;
+  return row_entries[m_cursor_col];
+}
+
+void SkylanderQuickMenu::MoveCursor(int dx, int dy)
+{
+  std::lock_guard lk(m_mutex);
+  const int row_count = static_cast<int>(m_rows.size());
+  if (row_count == 0)
+    return;
+
+  if (dy != 0)
+  {
+    m_cursor_row = ((m_cursor_row + dy) % row_count + row_count) % row_count;
+    m_cursor_col =
+        std::min(m_cursor_col, static_cast<int>(m_rows[m_cursor_row].entries.size()) - 1);
+  }
+
+  if (dx != 0)
+  {
+    m_cursor_col += dx;
+    if (m_cursor_col >= static_cast<int>(m_rows[m_cursor_row].entries.size()))
+    {
+      m_cursor_row = (m_cursor_row + 1) % row_count;
+      m_cursor_col = 0;
+    }
+    else if (m_cursor_col < 0)
+    {
+      m_cursor_row = (m_cursor_row - 1 + row_count) % row_count;
+      m_cursor_col = static_cast<int>(m_rows[m_cursor_row].entries.size()) - 1;
+    }
+  }
+
+  m_scroll_to_cursor = true;
+}
+
+void SkylanderQuickMenu::SwitchSlot(int delta)
+{
+  std::lock_guard lk(m_mutex);
+  const int slot = ((m_selected_slot + delta) % NUM_SLOTS + NUM_SLOTS) % NUM_SLOTS;
+  const bool was_items = m_selected_slot == ITEM_SLOT;
+  m_selected_slot = slot;
+  const bool is_items = slot == ITEM_SLOT;
+
+  if (was_items != is_items)
+  {
+    // Different list: start on whatever is in the newly selected slot.
+    RebuildLayout(false);
+    PlaceCursorOnPath(m_slots[slot].path);
+  }
+}
+
+SkylanderQuickMenu::Action SkylanderQuickMenu::Confirm()
+{
+  std::lock_guard lk(m_mutex);
+  Action action;
+  action.slot = m_selected_slot;
+
+  const int index = CursorEntry();
+  if (index < 0)
+    return action;
+
+  const Entry& entry = m_entries[index];
+  if (entry.path == m_slots[m_selected_slot].path)
+    return action;  // Already sitting in this slot.
+  const bool is_item = entry.category == Category::Item || entry.category == Category::Trap;
+  if ((m_selected_slot == ITEM_SLOT) != is_item)
+    return action;
+
+  action.type = ActionType::Place;
+  action.path = entry.path;
+  return action;
+}
+
+SkylanderQuickMenu::Action SkylanderQuickMenu::RemoveFromSlot()
+{
+  std::lock_guard lk(m_mutex);
+  Action action;
+  action.slot = m_selected_slot;
+  if (!m_slots[m_selected_slot].path.empty() || !m_slots[m_selected_slot].name.empty())
+    action.type = ActionType::Remove;
+  return action;
+}
+
+AbstractTexture* SkylanderQuickMenu::GetTexture(const std::string& path, int* loads_left)
+{
+  if (path.empty())
+    return nullptr;
+
+  if (const auto it = m_textures.find(path); it != m_textures.end())
+    return it->second.get();
+
+  if (*loads_left <= 0 || !g_gfx)
+    return nullptr;
+  --*loads_left;
+
+  std::unique_ptr<AbstractTexture> texture;
+  std::string file_data;
+  Common::UniqueBuffer<u8> pixels;
+  u32 width = 0;
+  u32 height = 0;
+  if (File::ReadFileToString(path, file_data) &&
+      Common::LoadPNG(std::span(reinterpret_cast<const u8*>(file_data.data()), file_data.size()),
+                      &pixels, &width, &height) &&
+      width > 0 && height > 0)
+  {
+    ShrinkRGBA(&pixels, &width, &height);
+    const TextureConfig config(width, height, 1, 1, 1, AbstractTextureFormat::RGBA8, 0,
+                               AbstractTextureType::Texture_2DArray);
+    texture = g_gfx->CreateTexture(config, "Skylander portrait");
+    if (texture)
+      texture->Load(0, width, height, width, pixels.data(), size_t{width} * height * 4);
+  }
+
+  // Failures are cached too (as null) so a bad file isn't re-read every frame.
+  auto* const result = texture.get();
+  m_textures.insert_or_assign(path, std::move(texture));
+  return result;
+}
+
+void SkylanderQuickMenu::ReleaseTextures()
+{
+  std::lock_guard lk(m_mutex);
+  m_textures.clear();
+}
+
+void SkylanderQuickMenu::Display()
+{
+  if (!IsOpen())
+    return;
+
+  std::lock_guard lk(m_mutex);
+
+  const ImGuiStyle& style = ImGui::GetStyle();
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  const float global_scale = std::max(style.FontScaleMain * style.FontScaleDpi, 0.01f);
+  // Aim for roughly 1/36th of the screen height per line of text, never smaller than the OSD.
+  const float font_base = std::max(style.FontSizeBase, display.y / 36.0f / global_scale);
+  ImGui::PushFont(nullptr, font_base);
+
+  const float font = ImGui::GetFontSize();
+  const float small_font = font * 0.72f;
+  const float pad = font * 0.6f;
+  const float gap = font * 0.35f;
+  const float width = std::min(display.x * 0.92f, font * 26.0f);
+  const float card_w = (width - gap * (COLUMNS - 1)) / COLUMNS;
+  const float card_h = card_w + small_font * 1.5f;
+  int loads_left = TEXTURE_LOADS_PER_FRAME;
+
+  ImGui::SetNextWindowPos(ImVec2(display.x * 0.5f, display.y * 0.5f), ImGuiCond_Always,
+                          ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowBgAlpha(0.94f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(pad, pad));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, font * 0.5f);
+  ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(gap, gap));
+  ImGui::PushStyleColor(ImGuiCol_WindowBg, IM_COL32(18, 18, 28, 255));
+  ImGui::PushStyleColor(ImGuiCol_Border, COLOR_ACCENT);
+
+  constexpr ImGuiWindowFlags window_flags =
+      ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+      ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoNav |
+      ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoFocusOnAppearing |
+      ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoScrollbar;
+
+  if (ImGui::Begin("Skylanders Quick Menu", nullptr, window_flags))
+  {
+    ImDrawList* draw = ImGui::GetWindowDrawList();
+
+    // Title
+    {
+      const char* title = "PORTAL OF POWER";
+      ImGui::SetCursorPosX((width + pad * 2.0f - ImGui::CalcTextSize(title).x) * 0.5f);
+      ImGui::PushStyleColor(ImGuiCol_Text, COLOR_TITLE);
+      ImGui::TextUnformatted(title);
+      ImGui::PopStyleColor();
+    }
+
+    // Slot tabs
+    {
+      constexpr int count = NUM_SLOTS;
+      const float slot_w =
+          (width - gap * static_cast<float>(count - 1)) / static_cast<float>(count);
+      const float slot_h = font * 2.5f;
+      const ImVec2 origin = ImGui::GetCursorScreenPos();
+      for (int v = 0; v < count; ++v)
+      {
+        const int slot = v;
+        const bool selected = slot == m_selected_slot;
+        const ImVec2 p0(origin.x + static_cast<float>(v) * (slot_w + gap), origin.y);
+        const ImVec2 p1(p0.x + slot_w, p0.y + slot_h);
+        draw->AddRectFilled(p0, p1, selected ? COLOR_SLOT_SELECTED_BG : COLOR_SLOT_BG,
+                            font * 0.3f);
+        if (selected)
+          draw->AddRect(p0, p1, COLOR_ACCENT, font * 0.3f, 0, std::max(2.0f, font * 0.1f));
+
+        const std::string label =
+            fmt::format("Slot {}{}", slot + 1, slot == ITEM_SLOT ? " - Items" : "");
+        draw->AddText(nullptr, small_font, ImVec2(p0.x + pad * 0.6f, p0.y + font * 0.25f),
+                      selected ? COLOR_ACCENT : COLOR_DIM, label.c_str());
+
+        const bool empty = m_slots[slot].name.empty();
+        ImGui::PushClipRect(p0, p1, true);
+        draw->AddText(ImVec2(p0.x + pad * 0.6f, p0.y + font * 1.2f),
+                      empty ? COLOR_DIM : COLOR_TEXT, empty ? "Empty" : m_slots[slot].name.c_str());
+        ImGui::PopClipRect();
+      }
+      ImGui::Dummy(ImVec2(width, slot_h));
+    }
+
+    // Grid
+    {
+      float content_h = 0.0f;
+      for (const Row& row : m_rows)
+        content_h += card_h + gap + (row.first_in_section ? small_font + gap : 0.0f);
+      const float grid_h = std::max(card_h, std::min(content_h, display.y * 0.6f));
+
+      ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(0, 0));
+      if (ImGui::BeginChild("figures", ImVec2(width, grid_h), ImGuiChildFlags_None,
+                            ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoNav |
+                                ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoBackground))
+      {
+        ImDrawList* grid_draw = ImGui::GetWindowDrawList();
+        const float clip_top = ImGui::GetWindowPos().y;
+        const float clip_bottom = clip_top + grid_h;
+
+        for (int r = 0; r < static_cast<int>(m_rows.size()); ++r)
+        {
+          const Row& row = m_rows[r];
+          if (row.first_in_section)
+          {
+            const ImVec2 hp = ImGui::GetCursorScreenPos();
+            grid_draw->AddText(nullptr, small_font, ImVec2(hp.x, hp.y + gap * 0.5f), COLOR_DIM,
+                               m_section_titles[row.section].c_str());
+            ImGui::Dummy(ImVec2(width, small_font + gap));
+          }
+
+          const ImVec2 row_pos = ImGui::GetCursorScreenPos();
+          if (r == m_cursor_row && m_scroll_to_cursor)
+          {
+            ImGui::SetScrollHereY(0.5f);
+            m_scroll_to_cursor = false;
+          }
+
+          // Skip drawing (and texture loading) for rows that are scrolled out of view.
+          const bool visible = row_pos.y + card_h >= clip_top && row_pos.y <= clip_bottom;
+          for (int c = 0; visible && c < static_cast<int>(row.entries.size()); ++c)
+          {
+            const Entry& entry = m_entries[row.entries[c]];
+            const bool selected = r == m_cursor_row && c == m_cursor_col;
+            const ImVec2 p0(row_pos.x + static_cast<float>(c) * (card_w + gap), row_pos.y);
+            const ImVec2 p1(p0.x + card_w, p0.y + card_h);
+            const float rounding = font * 0.3f;
+
+            grid_draw->AddRectFilled(p0, p1, selected ? COLOR_CARD_SELECTED_BG : COLOR_CARD_BG,
+                                     rounding);
+
+            // Portrait square: element color, with the cut-out photo or initials on top.
+            const float inset = card_w * 0.06f;
+            const ImVec2 s0(p0.x + inset, p0.y + inset);
+            const ImVec2 s1(p1.x - inset, s0.y + card_w - inset * 2.0f);
+            grid_draw->AddRectFilled(s0, s1, entry.color, rounding * 0.8f);
+
+            if (AbstractTexture* texture = GetTexture(entry.image_path, &loads_left))
+            {
+              const float box = s1.x - s0.x;
+              const float tw = static_cast<float>(texture->GetWidth());
+              const float th = static_cast<float>(texture->GetHeight());
+              const float scale = box * 0.94f / std::max(tw, th);
+              const ImVec2 size(tw * scale, th * scale);
+              const ImVec2 i0(s0.x + (box - size.x) * 0.5f, s0.y + (box - size.y) * 0.5f);
+              grid_draw->AddImage(*texture, i0, ImVec2(i0.x + size.x, i0.y + size.y));
+            }
+            else
+            {
+              const std::string initials = Initials(entry.name);
+              const float big = card_w * 0.32f;
+              const ImVec2 text_size =
+                  ImGui::GetFont()->CalcTextSizeA(big, FLT_MAX, 0.0f, initials.c_str());
+              grid_draw->AddText(nullptr, big,
+                                 ImVec2((s0.x + s1.x - text_size.x) * 0.5f,
+                                        (s0.y + s1.y - text_size.y) * 0.5f),
+                                 IM_COL32(255, 255, 255, 230), initials.c_str());
+            }
+
+            // Name
+            ImGui::PushClipRect(ImVec2(p0.x + inset, p0.y), ImVec2(p1.x - inset, p1.y), true);
+            const ImVec2 name_size =
+                ImGui::GetFont()->CalcTextSizeA(small_font, FLT_MAX, 0.0f, entry.name.c_str());
+            const float name_x = std::max(p0.x + inset, (p0.x + p1.x - name_size.x) * 0.5f);
+            grid_draw->AddText(nullptr, small_font, ImVec2(name_x, s1.y + small_font * 0.2f),
+                               selected ? IM_COL32_WHITE : COLOR_TEXT, entry.name.c_str());
+            ImGui::PopClipRect();
+
+            // Tag: which slot it's in, otherwise NEW for figures without a file yet.
+            std::string tag;
+            bool tag_accent = true;
+            for (int s = 0; s < NUM_SLOTS && tag.empty(); ++s)
+            {
+              if (!m_slots[s].path.empty() && m_slots[s].path == entry.path)
+                tag = fmt::format("SLOT {}", s + 1);
+            }
+            if (tag.empty() && entry.is_new)
+            {
+              tag = "NEW";
+              tag_accent = false;
+            }
+            if (!tag.empty())
+            {
+              const float tag_font = small_font * 0.85f;
+              const ImVec2 ts =
+                  ImGui::GetFont()->CalcTextSizeA(tag_font, FLT_MAX, 0.0f, tag.c_str());
+              const ImVec2 t1(s1.x - inset * 0.5f, s0.y + inset * 0.5f + ts.y + tag_font * 0.2f);
+              const ImVec2 t0(t1.x - ts.x - tag_font * 0.5f, s0.y + inset * 0.5f);
+              grid_draw->AddRectFilled(t0, t1, tag_accent ? COLOR_ACCENT : COLOR_TAG_BG,
+                                       tag_font * 0.25f);
+              grid_draw->AddText(nullptr, tag_font,
+                                 ImVec2(t0.x + tag_font * 0.25f, t0.y + tag_font * 0.1f),
+                                 tag_accent ? COLOR_ACCENT_DARK : COLOR_DIM, tag.c_str());
+            }
+
+            if (selected)
+              grid_draw->AddRect(p0, p1, COLOR_ACCENT, rounding, 0, std::max(2.0f, font * 0.1f));
+          }
+
+          ImGui::Dummy(ImVec2(width, card_h + gap));
+        }
+
+        if (m_rows.empty())
+        {
+          ImGui::PushStyleColor(ImGuiCol_Text, COLOR_DIM);
+          ImGui::TextUnformatted(m_selected_slot == ITEM_SLOT ? "No items found." :
+                                                                "No Skylanders found.");
+          ImGui::PopStyleColor();
+        }
+      }
+      ImGui::EndChild();
+      ImGui::PopStyleVar();
+    }
+
+    // Controls hint
+    {
+      ImGui::PushStyleColor(ImGuiCol_Text, COLOR_DIM);
+      ImGui::PushFont(nullptr, font_base * 0.7f);
+      ImGui::TextUnformatted("D-pad/Stick: Move    L1/R1: Change slot    Cross: Place");
+      ImGui::TextUnformatted("Triangle: Remove from slot    Circle/PS: Close");
+      ImGui::PopFont();
+      ImGui::PopStyleColor();
+    }
+  }
+  ImGui::End();
+
+  ImGui::PopStyleColor(2);
+  ImGui::PopStyleVar(3);
+  ImGui::PopFont();
+}
