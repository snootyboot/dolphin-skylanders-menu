+constexpr ImU32 COLOR_SLOT_SELECTED_BG = IM_COL32(120, 70, 10, 255);
+constexpr ImU32 COLOR_CARD_BG = IM_COL32(28, 28, 42, 255);
+constexpr ImU32 COLOR_CARD_SELECTED_BG = IM_COL32(58, 42, 16, 255);
