diff --git a/Source/Core/VideoCommon/SkylanderQuickMenu.cpp b/Source/Core/VideoCommon/SkylanderQuickMenu.cpp
new file mode 100644
index 0000000..47936d7
--- /dev/null
+++ b/Source/Core/VideoCommon/SkylanderQuickMenu.cpp
@@ -0,0 +1,297 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoCommon/SkylanderQuickMenu.h"
+
+#include <algorithm>
+#include <utility>
+
+#include <fmt/format.h>
+#include <imgui.h>
+
+namespace VideoCommon
+{
+namespace
+{
+constexpr int VISIBLE_ROWS = 9;
+
+constexpr ImU32 COLOR_TITLE = IM_COL32(255, 205, 80, 255);
+constexpr ImU32 COLOR_TEXT = IM_COL32(235, 235, 240, 255);
+constexpr ImU32 COLOR_DIM = IM_COL32(150, 150, 165, 255);
+constexpr ImU32 COLOR_ACCENT = IM_COL32(255, 170, 40, 255);
+constexpr ImU32 COLOR_SLOT_BG = IM_COL32(40, 40, 55, 255);
+constexpr ImU32 COLOR_SLOT_SELECTED_BG = IM_COL32(120, 70, 10, 255);
+constexpr ImU32 COLOR_ROW_SELECTED_BG = IM_COL32(255, 170, 40, 70);
+constexpr ImU32 COLOR_REMOVE = IM_COL32(255, 110, 100, 255);
+}  // namespace
+
+SkylanderQuickMenu& SkylanderQuickMenu::GetInstance()
+{
+  static SkylanderQuickMenu instance;
+  return instance;
+}
+
+void SkylanderQuickMenu::Open()
+{
+  std::lock_guard lk(m_mutex);
+  PlaceCursorOnCurrentFigure();
+  m_place_cursor_pending = true;
+  m_open.store(true, std::memory_order_relaxed);
+}
+
+void SkylanderQuickMenu::Close()
+{
+  m_open.store(false, std::memory_order_relaxed);
+}
+
+void SkylanderQuickMenu::SetEntries(std::vector<Entry> entries)
+{
+  std::lock_guard lk(m_mutex);
+  m_entries = std::move(entries);
+  if (m_place_cursor_pending)
+  {
+    PlaceCursorOnCurrentFigure();
+    m_place_cursor_pending = false;
+  }
+  m_cursor = std::clamp(m_cursor, 0, GetRowCount() - 1);
+  m_scroll_to_cursor = true;
+}
+
+void SkylanderQuickMenu::SetSlotContents(int slot, std::string name, std::string path)
+{
+  if (slot < 0 || slot >= NUM_SLOTS)
+    return;
+
+  std::lock_guard lk(m_mutex);
+  m_slots[slot] = {std::move(name), std::move(path)};
+}
+
+void SkylanderQuickMenu::MoveCursor(int delta)
+{
+  std::lock_guard lk(m_mutex);
+  const int rows = GetRowCount();
+  m_cursor = ((m_cursor + delta) % rows + rows) % rows;
+  m_scroll_to_cursor = true;
+}
+
+void SkylanderQuickMenu::SwitchSlot(int delta)
+{
+  std::lock_guard lk(m_mutex);
+  m_selected_slot = ((m_selected_slot + delta) % NUM_SLOTS + NUM_SLOTS) % NUM_SLOTS;
+}
+
+SkylanderQuickMenu::Action SkylanderQuickMenu::Confirm()
+{
+  std::lock_guard lk(m_mutex);
+  Action action;
+  action.slot = m_selected_slot;
+
+  if (m_cursor == 0)
+  {
+    if (!m_slots[m_selected_slot].name.empty())
+      action.type = ActionType::Remove;
+    return action;
+  }
+
+  const auto index = static_cast<size_t>(m_cursor - 1);
+  if (index >= m_entries.size())
+    return action;
+
+  // Already sitting in this slot: nothing to do.
+  if (m_entries[index].path == m_slots[m_selected_slot].path)
+    return action;
+
+  action.type = ActionType::Place;
+  action.path = m_entries[index].path;
+  return action;
+}
+
+void SkylanderQuickMenu::PlaceCursorOnCurrentFigure()
+{
+  const std::string& current = m_slots[m_selected_slot].path;
+  m_cursor = m_entries.empty() ? 0 : 1;
+  if (!current.empty())
+  {
+    const auto it = std::ranges::find(m_entries, current, &Entry::path);
+    if (it != m_entries.end())
+      m_cursor = static_cast<int>(std::distance(m_entries.begin(), it)) + 1;
+  }
+  m_scroll_to_cursor = true;
+}
+
+void SkylanderQuickMenu::Display()
+{
+  if (!IsOpen())
+    return;
+
+  std::lock_guard lk(m_mutex);
+
+  const ImGuiStyle& style = ImGui::GetStyle();
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  const float global_scale = std::max(style.FontScaleMain * style.FontScaleDpi, 0.01f);
+  // Aim for roughly 1/34th of the screen height per line of text, never smaller than the OSD.
+  const float font_base = std::max(style.FontSizeBase, display.y / 34.0f / global_scale);
+  ImGui::PushFont(nullptr, font_base);
+
+  const float font = ImGui::GetFontSize();
+  const float pad = font * 0.6f;
+  const float width = std::min(display.x * 0.9f, font * 20.0f);
+  const float row_height = font * 1.5f;
+
+  ImGui::SetNextWindowPos(ImVec2(display.x * 0.5f, display.y * 0.5f), ImGuiCond_Always,
+                          ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowBgAlpha(0.93f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(pad, pad));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, font * 0.5f);
+  ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(pad * 0.5f, pad * 0.5f));
+  ImGui::PushStyleColor(ImGuiCol_WindowBg, IM_COL32(18, 18, 28, 255));
+  ImGui::PushStyleColor(ImGuiCol_Border, COLOR_ACCENT);
+
+  constexpr ImGuiWindowFlags window_flags =
+      ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+      ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoNav |
+      ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoFocusOnAppearing |
+      ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoScrollbar;
+
+  if (ImGui::Begin("Skylanders Quick Menu", nullptr, window_flags))
+  {
+    ImDrawList* draw = ImGui::GetWindowDrawList();
+
+    // Title
+    {
+      const char* title = "PORTAL OF POWER";
+      const float title_w = ImGui::CalcTextSize(title).x;
+      ImGui::SetCursorPosX((width + pad * 2.0f - title_w) * 0.5f);
+      ImGui::PushStyleColor(ImGuiCol_Text, COLOR_TITLE);
+      ImGui::TextUnformatted(title);
+      ImGui::PopStyleColor();
+    }
+
+    // Slot selector
+    {
+      const float gap = pad * 0.5f;
+      const float slot_w = (width - gap) * 0.5f;
+      const float slot_h = font * 2.6f;
+      const ImVec2 origin = ImGui::GetCursorScreenPos();
+      for (int i = 0; i < NUM_SLOTS; ++i)
+      {
+        const bool selected = i == m_selected_slot;
+        const ImVec2 p0(origin.x + i * (slot_w + gap), origin.y);
+        const ImVec2 p1(p0.x + slot_w, p0.y + slot_h);
+        draw->AddRectFilled(p0, p1, selected ? COLOR_SLOT_SELECTED_BG : COLOR_SLOT_BG,
+                            font * 0.3f);
+        if (selected)
+          draw->AddRect(p0, p1, COLOR_ACCENT, font * 0.3f, 0, std::max(2.0f, font * 0.1f));
+
+        const std::string label = fmt::format("Slot {}", i + 1);
+        draw->AddText(ImVec2(p0.x + pad * 0.6f, p0.y + font * 0.2f),
+                      selected ? COLOR_ACCENT : COLOR_DIM, label.c_str());
+
+        const bool empty = m_slots[i].name.empty();
+        const char* name = empty ? "Empty" : m_slots[i].name.c_str();
+        ImGui::PushClipRect(p0, p1, true);
+        draw->AddText(ImVec2(p0.x + pad * 0.6f, p0.y + font * 1.3f),
+                      empty ? COLOR_DIM : COLOR_TEXT, name);
+        ImGui::PopClipRect();
+      }
+      ImGui::Dummy(ImVec2(width, slot_h));
+    }
+
+    // Figure list
+    {
+      const int rows = GetRowCount();
+      const float list_h = row_height * std::min(rows, VISIBLE_ROWS) + pad * 0.5f;
+      ImGui::PushStyleColor(ImGuiCol_ChildBg, IM_COL32(10, 10, 16, 255));
+      ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(0, 0));
+      if (ImGui::BeginChild("figures", ImVec2(width, list_h), ImGuiChildFlags_None,
+                            ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoNav |
+                                ImGuiWindowFlags_NoScrollbar))
+      {
+        ImDrawList* list_draw = ImGui::GetWindowDrawList();
+        const float text_y = (row_height - font) * 0.5f;
+
+        for (int row = 0; row < rows; ++row)
+        {
+          const ImVec2 p0 = ImGui::GetCursorScreenPos();
+          const ImVec2 p1(p0.x + width, p0.y + row_height);
+          const bool selected = row == m_cursor;
+
+          if (selected)
+          {
+            list_draw->AddRectFilled(p0, p1, COLOR_ROW_SELECTED_BG, font * 0.2f);
+            list_draw->AddRectFilled(p0, ImVec2(p0.x + font * 0.2f, p1.y), COLOR_ACCENT);
+            if (m_scroll_to_cursor)
+            {
+              ImGui::SetScrollHereY(0.5f);
+              m_scroll_to_cursor = false;
+            }
+          }
+
+          if (row == 0)
+          {
+            const bool slot_empty = m_slots[m_selected_slot].name.empty();
+            const std::string text = fmt::format("Remove from Slot {}", m_selected_slot + 1);
+            list_draw->AddText(ImVec2(p0.x + font * 0.8f, p0.y + text_y),
+                               slot_empty ? COLOR_DIM : COLOR_REMOVE, text.c_str());
+          }
+          else
+          {
+            const Entry& entry = m_entries[row - 1];
+            const float sq = font * 0.7f;
+            const ImVec2 sq0(p0.x + font * 0.8f, p0.y + (row_height - sq) * 0.5f);
+            list_draw->AddRectFilled(sq0, ImVec2(sq0.x + sq, sq0.y + sq), entry.color,
+                                     sq * 0.25f);
+            list_draw->AddText(ImVec2(sq0.x + sq + font * 0.5f, p0.y + text_y),
+                               selected ? IM_COL32_WHITE : COLOR_TEXT, entry.name.c_str());
+
+            if (entry.is_new)
+            {
+              const char* tag = "NEW";
+              const float tag_w = ImGui::CalcTextSize(tag).x;
+              list_draw->AddText(ImVec2(p1.x - tag_w - font * 0.6f, p0.y + text_y), COLOR_DIM,
+                                 tag);
+            }
+
+            for (int s = 0; s < NUM_SLOTS; ++s)
+            {
+              if (m_slots[s].path.empty() || m_slots[s].path != entry.path)
+                continue;
+              const std::string tag = fmt::format("SLOT {}", s + 1);
+              const float tag_w = ImGui::CalcTextSize(tag.c_str()).x;
+              list_draw->AddText(ImVec2(p1.x - tag_w - font * 0.6f, p0.y + text_y),
+                                 COLOR_ACCENT, tag.c_str());
+            }
+          }
+
+          ImGui::Dummy(ImVec2(width, row_height));
+        }
+
+        if (m_entries.empty())
+        {
+          ImGui::PushStyleColor(ImGuiCol_Text, COLOR_DIM);
+          ImGui::TextUnformatted("  No Skylanders found.");
+          ImGui::PopStyleColor();
+        }
+      }
+      ImGui::EndChild();
+      ImGui::PopStyleVar();
+      ImGui::PopStyleColor();
+    }
+
+    // Controls hint
+    {
+      ImGui::PushStyleColor(ImGuiCol_Text, COLOR_DIM);
+      ImGui::PushFont(nullptr, font_base * 0.75f);
+      ImGui::TextUnformatted("Up/Down: Browse    Left/Right: Slot");
+      ImGui::TextUnformatted("Cross: Place    Circle / PS: Close");
+      ImGui::PopFont();
+      ImGui::PopStyleColor();
+    }
+  }
+  ImGui::End();
+
+  ImGui::PopStyleColor(2);
+  ImGui::PopStyleVar(3);
+  ImGui::PopFont();
+}
+}  // namespace VideoCommon
diff --git a/Source/Core/VideoCommon/SkylanderQuickMenu.h b/Source/Core/VideoCommon/SkylanderQuickMenu.h
new file mode 100644
index 0000000..695e8b6
--- /dev/null
+++ b/Source/Core/VideoCommon/SkylanderQuickMenu.h
@@ -0,0 +1,87 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+namespace VideoCommon
+{
+// In-game, controller-driven menu for placing Skylanders on the emulated Portal of Power.
+// Input is fed in from the hotkey thread, the figure list and slot contents are fed in from
+// the UI thread, and the menu is drawn on the video thread as part of the on-screen UI.
+class SkylanderQuickMenu
+{
+public:
+  static constexpr int NUM_SLOTS = 2;
+
+  struct Entry
+  {
+    std::string name;
+    std::string path;
+    u32 color = 0xFFFFFFFF;  // ImGui ABGR
+    // No file yet: one will be created in the collection folder when it's first placed.
+    bool is_new = false;
+  };
+
+  enum class ActionType
+  {
+    None,
+    Place,
+    Remove,
+  };
+
+  struct Action
+  {
+    ActionType type = ActionType::None;
+    int slot = 0;
+    std::string path;
+  };
+
+  static SkylanderQuickMenu& GetInstance();
+
+  void Open();
+  void Close();
+  bool IsOpen() const { return m_open.load(std::memory_order_relaxed); }
+
+  // UI thread
+  void SetEntries(std::vector<Entry> entries);
+  void SetSlotContents(int slot, std::string name, std::string path);
+
+  // Hotkey thread
+  void MoveCursor(int delta);
+  void SwitchSlot(int delta);
+  Action Confirm();
+
+  // Video thread, between ImGui::NewFrame and ImGui::Render
+  void Display();
+
+private:
+  struct SlotContents
+  {
+    std::string name;
+    std::string path;
+  };
+
+  SkylanderQuickMenu() = default;
+
+  // Row 0 is "Remove", rows 1..N are the entries.
+  int GetRowCount() const { return static_cast<int>(m_entries.size()) + 1; }
+  void PlaceCursorOnCurrentFigure();
+
+  mutable std::mutex m_mutex;
+  std::atomic<bool> m_open{false};
+  std::vector<Entry> m_entries;
+  std::array<SlotContents, NUM_SLOTS> m_slots;
+  int m_selected_slot = 0;
+  int m_cursor = 0;
+  bool m_scroll_to_cursor = false;
+  bool m_place_cursor_pending = false;
+};
+}  // namespace VideoCommon
