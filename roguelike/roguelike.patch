@@ -0,0 +1,111 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Plain-text formats used by the Skylanders roguelike dev tools. Kept free of Dolphin
+// dependencies so it can be unit-tested on its own.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace RoguelikeDev
+{
+constexpr std::size_t MAX_SESSION_STEPS = 200;
+constexpr std::size_t MAX_WATCH_ENTRIES = 64;
+constexpr std::size_t MAX_WATCH_OFFSETS = 8;
+constexpr std::size_t MAX_LABEL_LENGTH = 40;
+constexpr std::size_t MAX_NAME_LENGTH = 40;
+
+struct ParseError
+{
+  int line = 0;  // 1-based
+  std::string message;
+};
+
+// session.txt
+//   # comment
+//   title: Gold and health
+//   full_hp | Stand still at full health, then press End.
+struct SessionStep
+{
+  std::string label;
+  std::string instruction;
+};
+
+struct SessionScript
+{
+  std::string title;
+  std::vector<SessionStep> steps;
+  std::vector<ParseError> errors;
+};
+
+SessionScript ParseSessionScript(std::string_view text);
+
+// watch.txt
+//   # name | type | address [> offset ...]
+//   Gold | u32 | 0x80A1B2C0
+//   Health | f32 | 0x80701234 > 0x10 > 0x1A4
+// Each "> offset" reads a 32-bit pointer at the current address and adds the offset to it.
+enum class WatchType
+{
+  U8,
+  U16,
+  U32,
+  S8,
+  S16,
+  S32,
+  F32,
+  F64,
+  Hex32,
+};
+
+struct WatchEntry
+{
+  std::string name;
+  WatchType type = WatchType::U32;
+  std::uint32_t base = 0;
+  std::vector<std::int64_t> offsets;
+};
+
+struct WatchList
+{
+  std::vector<WatchEntry> entries;
+  std::vector<ParseError> errors;
+};
+
+WatchList ParseWatchList(std::string_view text);
+
+// Size in bytes of a value of the given type.
+std::size_t WatchTypeSize(WatchType type);
+// Formats a raw big-endian-decoded value (already byte-swapped to host order and zero-extended).
+std::string FormatWatchValue(WatchType type, std::uint64_t raw);
+
+// Lower-case, [a-z0-9_-] only, at most MAX_LABEL_LENGTH characters. Empty if nothing survives.
+std::string SanitizeLabel(std::string_view text);
+std::string JsonEscape(std::string_view text);
+std::string CsvEscape(std::string_view text);
+
+// Snapshot files: zstd( header + MEM1 + MEM2 ). Header fields are little-endian:
+//   0  char[8]  "SKRLSNAP"
+//   8  u32      version (1)
+//   12 u32      header size (48)
+//   16 u32      MEM1 size
+//   20 u32      MEM2 size (0 on GameCube)
+//   24 u64      frame number
+//   32 char[16] game ID, zero-padded
+constexpr std::uint32_t SNAPSHOT_VERSION = 1;
+constexpr std::size_t SNAPSHOT_HEADER_SIZE = 48;
+std::array<std::uint8_t, SNAPSHOT_HEADER_SIZE> MakeSnapshotHeader(std::uint32_t mem1_size,
+                                                                  std::uint32_t mem2_size,
+                                                                  std::uint64_t frame,
+                                                                  std::string_view game_id);
+
+std::optional<std::uint32_t> ParseAddress(std::string_view text);
+std::optional<std::int64_t> ParseOffset(std::string_view text);
+std::string_view Trim(std::string_view text);
+}  // namespace RoguelikeDev
