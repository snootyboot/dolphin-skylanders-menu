diff --git a/Source/Core/Core/Roguelike/Run.cpp b/Source/Core/Core/Roguelike/Run.cpp
new file mode 100644
index 0000000..635130d
--- /dev/null
+++ b/Source/Core/Core/Roguelike/Run.cpp
@@ -0,0 +1,401 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/Roguelike/Run.h"
+
+#include <algorithm>
+#include <optional>
+#include <string_view>
+
+#include <fmt/format.h>
+
+#include "Common/Logging/Log.h"
+#include "Core/ConfigManager.h"
+#include "Core/Core.h"
+#include "Core/HW/Memmap.h"
+#include "Core/PowerPC/MMU.h"
+#include "Core/System.h"
+
+namespace Roguelike
+{
+namespace
+{
+constexpr std::uint32_t FST_POINTER_ADDRESS = 0x80000038;
+constexpr std::uint32_t MEM1_BASE = 0x80000000;
+constexpr std::uint32_t MAX_FST_ENTRIES = 20000;
+constexpr std::uint32_t PARSE_RETRY_INTERVAL = 30;  // frames
+// A hub load this soon after entering a level is treated as part of the load, not a return.
+constexpr std::uint64_t MIN_FRAMES_IN_LEVEL = 60 * 20;
+// Level state byte (session 4): 0 = Ruins/hub, 1 = in a level (also paused / quick menu),
+// 2 = results screen after clearing the level.
+constexpr std::uint32_t LEVEL_STATE_ADDRESS = 0x80FADF2B;
+constexpr std::uint8_t LEVEL_STATE_RESULTS = 2;
+
+std::optional<std::uint32_t> ReadU32(const Core::CPUThreadGuard& guard, std::uint32_t address)
+{
+  const auto result = PowerPC::MMU::HostTryRead<u32>(guard, address);
+  if (!result)
+    return std::nullopt;
+  return result->value;
+}
+
+bool InMem1(Core::System& system, std::uint32_t address, std::uint32_t size)
+{
+  const std::uint32_t mem1_size = system.GetMemory().GetRamSizeReal();
+  return address >= MEM1_BASE && address - MEM1_BASE <= mem1_size &&
+         size <= mem1_size - (address - MEM1_BASE);
+}
+
+std::string_view StemOf(std::string_view name)
+{
+  const auto dot = name.rfind('.');
+  return dot == std::string_view::npos ? name : name.substr(0, dot);
+}
+
+std::string_view ExtensionOf(std::string_view name)
+{
+  const auto dot = name.rfind('.');
+  return dot == std::string_view::npos ? std::string_view{} : name.substr(dot + 1);
+}
+
+bool EqualsNoCase(std::string_view a, std::string_view b)
+{
+  return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+           return (x | 0x20) == (y | 0x20);
+         });
+}
+
+bool StartsWith(std::string_view text, std::string_view prefix)
+{
+  return text.size() >= prefix.size() && text.substr(0, prefix.size()) == prefix;
+}
+}  // namespace
+
+bool IsRoguelikeGame()
+{
+  return SConfig::GetInstance().GetGameID() == RUN_GAME_ID;
+}
+
+Run& Run::GetInstance()
+{
+  static Run instance;
+  return instance;
+}
+
+Run::Run()
+{
+  m_state_hook = Core::AddOnStateChangedCallback([this](Core::State state) {
+    // Closing or rebooting the game ends the run (no saving, by design).
+    if (state == Core::State::Uninitialized || state == Core::State::Starting)
+    {
+      std::lock_guard lk(m_mutex);
+      ResetLocked();
+    }
+  });
+}
+
+void Run::ResetLocked()
+{
+  m_fst_valid = false;
+  m_fst_address = 0;
+  m_parse_retry_frames = 0;
+  m_error.clear();
+  m_level_files.clear();
+  m_entrance = {};
+  m_targets = {};
+  m_is_wii = false;
+  m_complete = false;
+  m_over = false;
+  m_cleared = false;
+  m_loop = 0;
+  m_level = 0;
+  m_in_level = false;
+  m_frames_in_level = 0;
+  m_last_stem.clear();
+}
+
+void Run::OnFrameEnd(Core::System& system)
+{
+  if (!IsRoguelikeGame())
+    return;
+
+  std::lock_guard lk(m_mutex);
+
+  if (m_in_level)
+  {
+    ++m_frames_in_level;
+    if (!m_cleared)
+    {
+      const Core::CPUThreadGuard guard(system);
+      const auto state = PowerPC::MMU::HostTryRead<u8>(guard, LEVEL_STATE_ADDRESS);
+      if (state && state->value == LEVEL_STATE_RESULTS)
+      {
+        m_cleared = true;
+        INFO_LOG_FMT(CORE, "Roguelike: cleared {}", RUN_LEVELS[m_level].display_name);
+      }
+    }
+  }
+
+  if (!m_fst_valid)
+  {
+    if (m_parse_retry_frames > 0)
+    {
+      --m_parse_retry_frames;
+      return;
+    }
+    m_parse_retry_frames = PARSE_RETRY_INTERVAL;
+
+    std::optional<std::uint32_t> fst_address;
+    {
+      const Core::CPUThreadGuard guard(system);
+      fst_address = ReadU32(guard, FST_POINTER_ADDRESS);
+    }
+    if (!fst_address || !InMem1(system, *fst_address, 12))
+      return;
+    if (!ParseFstLocked(system, *fst_address))
+      return;
+  }
+
+  ApplySwapLocked(system);
+}
+
+bool Run::ParseFstLocked(Core::System& system, std::uint32_t fst_address)
+{
+  const Core::CPUThreadGuard guard(system);
+
+  const auto root_word0 = ReadU32(guard, fst_address);
+  const auto count = ReadU32(guard, fst_address + 8);
+  if (!root_word0 || !count || (*root_word0 >> 24) != 1 || *count < 2 ||
+      *count > MAX_FST_ENTRIES || !InMem1(system, fst_address, *count * 12))
+  {
+    return false;
+  }
+
+  const std::uint32_t string_table = fst_address + *count * 12;
+  std::vector<FstFile> files;
+  Pair entrance;
+  std::array<Pair, RUN_LEVEL_COUNT> targets{};
+
+  for (std::uint32_t i = 1; i < *count; ++i)
+  {
+    const std::uint32_t entry = fst_address + i * 12;
+    const auto word0 = ReadU32(guard, entry);
+    const auto word1 = ReadU32(guard, entry + 4);
+    const auto word2 = ReadU32(guard, entry + 8);
+    if (!word0 || !word1 || !word2)
+      return false;
+    if ((*word0 >> 24) != 0)  // directory
+      continue;
+
+    const std::uint32_t name_offset = *word0 & 0x00FFFFFF;
+    const std::uint32_t name_address = string_table + name_offset;
+    if (!InMem1(system, name_address, 1))
+      return false;
+    const auto name = PowerPC::MMU::HostTryReadString(guard, name_address);
+    if (!name)
+      return false;
+    const std::string_view name_view = name->value;
+    if (!StartsWith(name_view, "Level_"))
+      continue;
+
+    FstFile file;
+    file.entry_address = entry;
+    file.name_offset = name_offset;
+    file.data_start = static_cast<std::uint64_t>(*word1) << (system.IsWii() ? 2 : 0);
+    file.data_end = file.data_start + *word2;
+    file.stem = std::string(StemOf(name_view));
+    const std::string_view ext = ExtensionOf(name_view);
+    const int index = static_cast<int>(files.size());
+
+    const auto assign = [&](Pair& pair) {
+      if (EqualsNoCase(ext, "arc"))
+        pair.arc = index;
+      else if (EqualsNoCase(ext, "bld"))
+        pair.bld = index;
+    };
+    if (file.stem == RUN_ENTRANCE_STEM)
+      assign(entrance);
+    for (int l = 0; l < RUN_LEVEL_COUNT; ++l)
+    {
+      if (file.stem == RUN_LEVELS[l].file_stem)
+        assign(targets[l]);
+    }
+    files.push_back(std::move(file));
+  }
+
+  const auto complete = [](const Pair& p) { return p.arc >= 0 && p.bld >= 0; };
+  std::string error;
+  if (!complete(entrance))
+    error = fmt::format("{} not found in the disc file table.", RUN_ENTRANCE_STEM);
+  for (int l = 0; l < RUN_LEVEL_COUNT && error.empty(); ++l)
+  {
+    if (!complete(targets[l]))
+      error = fmt::format("{} not found in the disc file table.", RUN_LEVELS[l].file_stem);
+  }
+  if (!error.empty())
+  {
+    if (error != m_error)
+      ERROR_LOG_FMT(CORE, "Roguelike: {}", error);
+    m_error = std::move(error);
+    return false;
+  }
+
+  m_level_files = std::move(files);
+  m_entrance = entrance;
+  m_targets = targets;
+  m_fst_address = fst_address;
+  m_is_wii = system.IsWii();
+  m_fst_valid = true;
+  m_error.clear();
+  INFO_LOG_FMT(CORE, "Roguelike: file table at {:08x}, {} level files", fst_address,
+               m_level_files.size());
+  return true;
+}
+
+void Run::ApplySwapLocked(Core::System& system)
+{
+  // Desired name offset for every managed entry: original, except the entrance and the current
+  // target swap names while the run is active.
+  struct Write
+  {
+    std::uint32_t address;
+    std::uint32_t value;
+  };
+  std::vector<Write> writes;
+  writes.reserve(4 + RUN_LEVEL_COUNT * 2);
+
+  const bool active = !m_complete && !m_over;
+  const Pair& current = m_targets[m_level];
+  const auto desired = [&](int index) -> std::uint32_t {
+    if (active)
+    {
+      if (index == m_entrance.arc)
+        return m_level_files[current.arc].name_offset;
+      if (index == m_entrance.bld)
+        return m_level_files[current.bld].name_offset;
+      if (index == current.arc)
+        return m_level_files[m_entrance.arc].name_offset;
+      if (index == current.bld)
+        return m_level_files[m_entrance.bld].name_offset;
+    }
+    return m_level_files[index].name_offset;
+  };
+  const auto add = [&](int index) {
+    writes.push_back({m_level_files[index].entry_address, desired(index)});
+  };
+  add(m_entrance.arc);
+  add(m_entrance.bld);
+  for (const Pair& pair : m_targets)
+  {
+    add(pair.arc);
+    add(pair.bld);
+  }
+
+  const Core::CPUThreadGuard guard(system);
+  for (const Write& w : writes)
+  {
+    const auto current_value = ReadU32(guard, w.address);
+    if (!current_value)
+      continue;
+    // Keep the type byte (0 for files) and only touch the 24-bit name offset.
+    const std::uint32_t value = (*current_value & 0xFF000000) | (w.value & 0x00FFFFFF);
+    if (value != *current_value)
+      PowerPC::MMU::HostTryWrite<u32>(guard, value, w.address);
+  }
+}
+
+void Run::OnDiscRead(std::uint64_t partition_offset, std::uint32_t length, bool in_partition)
+{
+  if (!IsRoguelikeGame())
+    return;
+
+  std::lock_guard lk(m_mutex);
+  // Wii file table offsets are relative to the game partition; ignore raw disc reads.
+  if (!m_fst_valid || (m_is_wii && !in_partition))
+    return;
+
+  const std::uint64_t end = partition_offset + std::max<std::uint32_t>(length, 1);
+  for (const FstFile& file : m_level_files)
+  {
+    if (partition_offset < file.data_end && end > file.data_start)
+    {
+      if (file.stem != m_last_stem)
+      {
+        m_last_stem = file.stem;
+        HandleLoadedStemLocked(file.stem);
+      }
+      return;
+    }
+  }
+}
+
+void Run::HandleLoadedStemLocked(const std::string& stem)
+{
+  if (m_complete || m_over)
+    return;
+
+  if (stem == RUN_LEVELS[m_level].file_stem)
+  {
+    if (!m_in_level)
+    {
+      m_in_level = true;
+      m_cleared = false;
+      m_frames_in_level = 0;
+      INFO_LOG_FMT(CORE, "Roguelike: entered {}", RUN_LEVELS[m_level].display_name);
+    }
+    return;
+  }
+
+  if (!StartsWith(stem, "Level_Hub") || !m_in_level)
+    return;
+
+  if (m_cleared)
+  {
+    m_in_level = false;
+    m_cleared = false;
+    AdvanceLocked();
+  }
+  else if (m_frames_in_level >= MIN_FRAMES_IN_LEVEL)
+  {
+    // Back in the Ruins without a results screen: the level was quit, which ends the run.
+    m_in_level = false;
+    m_over = true;
+    INFO_LOG_FMT(CORE, "Roguelike: quit {}, run over", RUN_LEVELS[m_level].display_name);
+  }
+}
+
+void Run::AdvanceLocked()
+{
+  ++m_level;
+  if (m_level >= RUN_LEVEL_COUNT)
+  {
+    m_level = 0;
+    ++m_loop;
+    if (m_loop >= RUN_LOOP_COUNT)
+    {
+      m_loop = RUN_LOOP_COUNT - 1;
+      m_level = RUN_LEVEL_COUNT - 1;
+      m_complete = true;
+    }
+  }
+  INFO_LOG_FMT(CORE, "Roguelike: next is loop {} level {}", m_loop + 1, m_level + 1);
+}
+
+RunStatus Run::GetStatus() const
+{
+  std::lock_guard lk(m_mutex);
+  RunStatus status;
+  status.show = m_fst_valid || !m_error.empty();
+  status.complete = m_complete;
+  status.over = m_over;
+  if (m_over)
+    status.over_level = RUN_LEVELS[m_level].display_name;
+  status.in_level = m_in_level;
+  status.loop = m_loop + 1;
+  status.level = m_level + 1;
+  status.level_name = RUN_LEVELS[m_level].display_name;
+  status.error = m_error;
+  return status;
+}
+
+}  // namespace Roguelike
diff --git a/Source/Core/Core/Roguelike/Run.h b/Source/Core/Core/Roguelike/Run.h
new file mode 100644
index 0000000..3e24d49
--- /dev/null
+++ b/Source/Core/Core/Roguelike/Run.h
@@ -0,0 +1,138 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Roguelike run state for Skylanders: Spyro's Adventure (SSPE52).
+//
+// Level loading: the game opens level archives by name through the disc file table (FST) that the
+// apploader leaves in MEM1. While a run is active, the FST entries of Shattered Island
+// (Level_027_Tutorial) and the run's current level have their name offsets swapped, so picking
+// Shattered Island on Flynn's map loads the current run level instead. Disc reads are matched to
+// FST data ranges (by the original names) to know which level is actually loading. A level counts
+// as cleared when the game's level state shows the results screen; returning to the hub after a
+// clear advances the run, returning without one (quitting) ends it.
+//
+// Threads: OnFrameEnd and OnDiscRead run on the CPU thread; GetStatus may be called from any
+// thread; the state-changed callback runs on the host thread. Everything is guarded by m_mutex.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "Common/HookableEvent.h"
+
+namespace Core
+{
+class System;
+}
+
+namespace Roguelike
+{
+inline constexpr int RUN_LEVEL_COUNT = 9;
+inline constexpr int RUN_LOOP_COUNT = 3;
+
+struct RunLevel
+{
+  const char* display_name;
+  const char* file_stem;
+};
+
+// Chapter order from the design doc. File stems confirmed in-game except Battlefield, Lava Lakes
+// Railway and Lair of Kaos, which match their file names.
