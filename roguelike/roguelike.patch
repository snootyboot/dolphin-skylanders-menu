+void HotkeyScheduler::HandleRoguelikeDevTools(bool emulation_running)
+{
+  auto& dev = RoguelikeDev::DevTools::GetInstance();
+
+  if (IsHotkey(HK_ROGUELIKE_DEV_TOGGLE_PANEL))
+    dev.ToggleOverlay();
+  if (IsHotkey(HK_ROGUELIKE_DEV_RELOAD))
+    dev.ReloadFiles();
+
+  const bool capture = IsHotkey(HK_ROGUELIKE_DEV_CAPTURE);
+  const bool skip = IsHotkey(HK_ROGUELIKE_DEV_SKIP);
+  const bool undo = IsHotkey(HK_ROGUELIKE_DEV_UNDO);
+  const bool record = IsHotkey(HK_ROGUELIKE_DEV_TOGGLE_RECORDING);
+  if (!(capture || skip || undo || record))
+    return;
+
+  if (!emulation_running)
+  {
+    OSD::AddMessage("Dev tools: start (or unpause) the game first.", OSD::Duration::NORMAL,
+                    OSD::Color::RED);
+    return;
+  }
+
+  if (capture)
+    dev.RequestCapture();
+  if (skip)
+    dev.Skip();
+  if (undo)
+    dev.Undo();
+  if (record)
+    dev.ToggleRecording();
+}
