+  std::uint32_t m_fst_address = 0;
+  std::uint32_t m_parse_retry_frames = 0;
+  std::string m_error;
+  std::vector<FstFile> m_level_files;  // every file whose name starts with "Level_"
+  Pair m_entrance;
+  std::array<Pair, RUN_LEVEL_COUNT> m_targets{};
+  bool m_is_wii = false;
+
+  // Run progress.
+  bool m_complete = false;
+  bool m_over = false;
+  bool m_cleared = false;  // results screen seen in the current run level
+  int m_loop = 0;   // 0-based
+  int m_level = 0;  // 0-based
+  bool m_in_level = false;
+  std::uint64_t m_frames_in_level = 0;
+  std::string m_last_stem;
+};
