+void DevTools::EnsureLoadedLocked()
+{
+  if (m_loaded)
+    return;
+  m_loaded = true;
+  LoadFilesLocked();
+  m_visible = !m_session->steps.empty() || !m_watches.empty();
+}
+
+void DevTools::LoadFilesLocked()
+{
+  const std::string folder = GetFolder();
+  File::CreateFullPath(folder);
+  const std::string readme = folder + "README.txt";
+  if (!File::Exists(readme))
+    File::WriteStringToFile(readme, README_TEXT);
+
+  m_file_errors.clear();
+
+  std::string text;
+  m_session.reset();
+  if (File::ReadFileToString(folder + "session.txt", text))
+  {
+    SessionScript script = ParseSessionScript(text);
+    for (const ParseError& error : script.errors)
+      m_file_errors.push_back(fmt::format("session.txt line {}: {}", error.line, error.message));
+    if (!script.steps.empty())
+    {
+      m_session = std::make_shared<Session>();
+      m_session->title = script.title.empty() ? "Untitled session" : script.title;
+      m_session->steps = std::move(script.steps);
+    }
+    else
+    {
+      m_file_errors.push_back("session.txt has no steps.");
+    }
+  }
+  StartSessionLocked();
+
+  text.clear();
+  m_watches.clear();
+  if (File::ReadFileToString(folder + "watch.txt", text))
+  {
+    WatchList list = ParseWatchList(text);
+    for (const ParseError& error : list.errors)
+      m_file_errors.push_back(fmt::format("watch.txt line {}: {}", error.line, error.message));
+    m_watches = std::move(list.entries);
+  }
+  m_watch_values.assign(m_watches.size(), "-");
+  m_watch_csv_values.assign(m_watches.size(), "");
+
+  if (!m_file_errors.empty())
+  {
+    WARN_LOG_FMT(CORE, "Roguelike dev tools:\n{}", fmt::join(m_file_errors, "\n"));
+  }
+}
+
+// A fresh session object: the next capture starts a new folder. Captures still being written
+// keep a reference to their old session, so nothing in flight is lost.
+void DevTools::StartSessionLocked()
+{
+  if (!m_session)
+    m_session = std::make_shared<Session>();
+  else
+    m_session = std::make_shared<Session>(Session{m_session->title, m_session->steps, {}, {}, {}});
+  m_step = 0;
+  m_history.clear();
+  m_capture_requested = false;
+}
+
+bool DevTools::EnsureSessionDirLocked()
+{
+  if (!m_session->dir.empty())
+    return true;
+
+  const std::string stamp = LocalTimeString("%Y%m%d-%H%M%S");
+  std::string name = stamp;
+  const std::string title_label = SanitizeLabel(m_session->title);
+  if (!title_label.empty())
+    name += "_" + title_label;
+
+  const std::string base = GetFolder() + "Captures" DIR_SEP;
+  std::string dir = base + name + DIR_SEP;
+  for (int i = 2; File::Exists(dir) && i < 100; ++i)
+    dir = base + fmt::format("{}_{}", name, i) + DIR_SEP;
+
+  if (!File::CreateFullPath(dir))
+  {
+    SetStatusLocked("Couldn't create the capture folder.", StatusKind::Error);
+    return false;
+  }
+  m_session->dir = dir;
+  m_session->started = LocalTimeString("%Y-%m-%dT%H:%M:%S");
+  return true;
+}
