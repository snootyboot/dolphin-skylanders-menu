+// Emulated main memory only: never touch MMIO or unmapped space from a watch.
+bool IsRamRange(std::uint32_t address, std::size_t size, std::uint32_t mem1_size,
+                std::uint32_t mem2_size)
+{
+  const auto in = [&](std::uint32_t base, std::uint32_t length) {
+    return length != 0 && address >= base && address - base < length &&
+           size <= length - (address - base);
+  };
+  return in(MEM1_BASE, mem1_size) || in(MEM1_UNCACHED_BASE, mem1_size) ||
+         in(MEM2_BASE, mem2_size) || in(MEM2_UNCACHED_BASE, mem2_size);
+}
