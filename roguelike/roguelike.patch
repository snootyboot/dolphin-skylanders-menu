+inline constexpr const char* RUN_ENTRANCE_NAME = "Shattered Island";
+inline constexpr const char* RUN_GAME_ID = "SSPE52";
+
+struct RunStatus
+{
+  bool show = false;      // game recognised and file table read
+  bool complete = false;  // all loops finished
+  bool over = false;      // quit a level: run ended
+  std::string over_level; // level that was quit
+  bool in_level = false;  // currently inside the run level
+  int loop = 1;           // 1-based
+  int level = 1;          // 1-based
+  std::string level_name;
+  std::string error;  // non-empty if the file table could not be used
