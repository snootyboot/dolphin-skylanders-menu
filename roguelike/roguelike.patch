+// ---------------------------------------------------------------------------------------------
+// Hotkey thread
+
+void DevTools::RequestCapture()
+{
+  std::lock_guard lk(m_mutex);
+  EnsureLoadedLocked();
+
+  if (m_captures_in_flight >= MAX_CAPTURES_IN_FLIGHT)
+  {
+    SetStatusLocked("Still saving the last capture - press again in a moment.", StatusKind::Error);
+    return;
+  }
+  if (m_capture_requested)
+    return;
+
+  m_capture_requested = true;
+  m_capture_request_step = m_step;
+  m_capture_request_time = std::chrono::steady_clock::now();
+}
+
+void DevTools::Undo()
+{
+  std::lock_guard lk(m_mutex);
+  EnsureLoadedLocked();
+
+  if (m_capture_requested)
+  {
+    m_capture_requested = false;
+    SetStatusLocked("Capture cancelled.", StatusKind::Info);
+    return;
+  }
+  if (m_history.empty())
+  {
+    SetStatusLocked("Nothing to undo.", StatusKind::Info);
+    return;
+  }
+
+  const Action action = m_history.back();
+  m_history.pop_back();
+
+  Entry& entry = m_session->entries[action.entry];
+  const EntryStatus previous = entry.status;
+  entry.status = EntryStatus::Discarded;
+  if (action.is_capture && previous == EntryStatus::Saved && !entry.file.empty())
+  {
+    Job job;
+    job.kind = Job::Kind::Delete;
+    job.session = m_session;
+    job.path = m_session->dir + entry.file;
+    QueueJobLocked(std::move(job));
+  }
+  // A capture that's still saving is deleted by the worker once it sees it was discarded.
+
+  if (action.step >= 0)
+    m_step = static_cast<std::size_t>(action.step);
+
+  SetStatusLocked(fmt::format("Undid {} '{}'.", action.is_capture ? "capture" : "skip",
+                              entry.label),
+                  StatusKind::Info);
+  QueueManifestLocked();
+}
+
+void DevTools::Skip()
+{
+  std::lock_guard lk(m_mutex);
+  EnsureLoadedLocked();
+
+  if (m_session->steps.empty() || m_step >= m_session->steps.size())
+  {
+    SetStatusLocked("No step to skip.", StatusKind::Info);
+    return;
+  }
+  if (!EnsureSessionDirLocked())
+    return;
+
+  m_capture_requested = false;
+  const SessionStep& step = m_session->steps[m_step];
+  Entry entry;
+  entry.index = static_cast<int>(m_session->entries.size()) + 1;
+  entry.step = static_cast<int>(m_step);
+  entry.label = step.label;
+  entry.instruction = step.instruction;
+  entry.status = EntryStatus::Skipped;
+  entry.time = LocalTimeString("%Y-%m-%dT%H:%M:%S");
+  m_session->entries.push_back(std::move(entry));
+  m_history.push_back({false, static_cast<int>(m_step), m_session->entries.size() - 1});
+  ++m_step;
+
+  SetStatusLocked(fmt::format("Skipped '{}'.", step.label), StatusKind::Info);
+  QueueManifestLocked();
+}
