+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoCommon/RoguelikeDevOverlay.h"
+
+#include <algorithm>
+#include <string>
+
+#include <fmt/format.h>
+#include <imgui.h>
+
+#include "Core/Roguelike/Run.h"
+#include "Core/RoguelikeDev/DevTools.h"
+
+namespace VideoCommon
+{
+namespace
+{
+constexpr ImU32 COLOR_BG = IM_COL32(12, 14, 22, 255);
+constexpr ImU32 COLOR_BORDER = IM_COL32(255, 196, 64, 255);
+constexpr ImU32 COLOR_TITLE = IM_COL32(255, 196, 64, 255);
+constexpr ImU32 COLOR_TEXT = IM_COL32(235, 235, 240, 255);
+constexpr ImU32 COLOR_DIM = IM_COL32(150, 155, 170, 255);
+constexpr ImU32 COLOR_OK = IM_COL32(110, 230, 120, 255);
+constexpr ImU32 COLOR_ERROR = IM_COL32(255, 105, 95, 255);
+constexpr ImU32 COLOR_INFO = IM_COL32(120, 200, 255, 255);
+constexpr ImU32 COLOR_REC = IM_COL32(255, 70, 70, 255);
+constexpr std::size_t MAX_ERRORS_SHOWN = 4;
+
+void ColoredText(ImU32 color, const std::string& text)
+{
+  ImGui::PushStyleColor(ImGuiCol_Text, color);
+  ImGui::TextUnformatted(text.c_str(), text.c_str() + text.size());
+  ImGui::PopStyleColor();
+}
+
+void WrappedText(ImU32 color, const std::string& text)
+{
+  ImGui::PushStyleColor(ImGuiCol_Text, color);
+  ImGui::TextWrapped("%s", text.c_str());
+  ImGui::PopStyleColor();
+}
+
+// Small box in the top-right corner: where the run is and what to do next.
+void DrawRunStatus()
+{
+  const Roguelike::RunStatus run = Roguelike::Run::GetInstance().GetStatus();
+  if (!run.show)
+    return;
+
+  const ImGuiStyle& style = ImGui::GetStyle();
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  if (display.x <= 0.0f || display.y <= 0.0f)
+    return;
+  const float global_scale = std::max(style.FontScaleMain * style.FontScaleDpi, 0.01f);
+  const float font_base = std::max(style.FontSizeBase, display.y / 46.0f / global_scale);
+  ImGui::PushFont(nullptr, font_base);
+  const float font = ImGui::GetFontSize();
+  const float pad = font * 0.5f;
+
+  ImGui::SetNextWindowPos(ImVec2(display.x - pad, pad), ImGuiCond_Always, ImVec2(1.0f, 0.0f));
+  ImGui::SetNextWindowBgAlpha(0.75f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(pad, pad * 0.6f));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, font * 0.35f);
+  ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(font * 0.4f, font * 0.15f));
+  ImGui::PushStyleColor(ImGuiCol_WindowBg, COLOR_BG);
+  ImGui::PushStyleColor(ImGuiCol_Border, COLOR_BORDER);
+
+  constexpr ImGuiWindowFlags flags =
+      ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+      ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoNav |
+      ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoFocusOnAppearing |
+      ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_AlwaysAutoResize;
+
+  if (ImGui::Begin("Roguelike Run", nullptr, flags))
+  {
+    if (!run.error.empty())
+    {
+      ColoredText(COLOR_ERROR, "Roguelike: level files not found");
+      ColoredText(COLOR_DIM, run.error);
+    }
+    else if (run.over)
+    {
+      ColoredText(COLOR_ERROR, "RUN OVER");
+      ColoredText(COLOR_DIM, fmt::format("Quit {} on loop {}", run.over_level, run.loop));
+      ColoredText(COLOR_DIM, "Restart the game for a new run");
+    }
+    else if (run.complete)
+    {
+      ColoredText(COLOR_OK, "RUN COMPLETE");
+      ColoredText(COLOR_DIM, fmt::format("All {} loops cleared", Roguelike::RUN_LOOP_COUNT));
+    }
+    else
+    {
+      ColoredText(COLOR_TITLE, fmt::format("Loop {}  -  Level {}/{}", run.loop, run.level,
+                                           Roguelike::RUN_LEVEL_COUNT));
+      ColoredText(COLOR_TEXT, run.level_name);
+      if (!run.in_level)
+      {
+        ColoredText(COLOR_DIM,
+                    fmt::format("Pick {} on Flynn's map", Roguelike::RUN_ENTRANCE_NAME));
+      }
+    }
+  }
+  ImGui::End();
+
+  ImGui::PopStyleColor(2);
+  ImGui::PopStyleVar(3);
+  ImGui::PopFont();
+}
+}  // namespace
+
+void DrawRoguelikeDevOverlay()
+{
+  DrawRunStatus();
+
+  const RoguelikeDev::OverlayState state = RoguelikeDev::DevTools::GetInstance().GetOverlayState();
+  if (!state.visible)
+    return;
+
+  const ImGuiStyle& style = ImGui::GetStyle();
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  if (display.x <= 0.0f || display.y <= 0.0f)
+    return;
+  const float global_scale = std::max(style.FontScaleMain * style.FontScaleDpi, 0.01f);
+  const float font_base = std::max(style.FontSizeBase, display.y / 46.0f / global_scale);
+  ImGui::PushFont(nullptr, font_base);
+
+  const float font = ImGui::GetFontSize();
+  const float pad = font * 0.5f;
+  const float width = std::min(display.x * 0.45f, font * 22.0f);
+
+  ImGui::SetNextWindowPos(ImVec2(pad, pad), ImGuiCond_Always);
+  ImGui::SetNextWindowSize(ImVec2(width, 0.0f), ImGuiCond_Always);
+  ImGui::SetNextWindowBgAlpha(0.88f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(pad, pad));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, font * 0.35f);
+  ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(font * 0.4f, font * 0.25f));
+  ImGui::PushStyleColor(ImGuiCol_WindowBg, COLOR_BG);
+  ImGui::PushStyleColor(ImGuiCol_Border, COLOR_BORDER);
+
+  constexpr ImGuiWindowFlags flags =
+      ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+      ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoNav |
+      ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoFocusOnAppearing |
+      ImGuiWindowFlags_NoScrollbar;
+
+  if (ImGui::Begin("Roguelike Dev Tools", nullptr, flags))
+  {
+    ImGui::PushTextWrapPos(width - pad);
+
+    ColoredText(COLOR_TITLE, "ROGUELIKE DEV TOOLS");
+    if (state.recording)
+    {
+      ImGui::SameLine();
+      ColoredText(COLOR_REC, "  REC");
+    }
+
+    if (state.has_session)
+    {
+      ColoredText(COLOR_DIM, state.session_title);
+      if (state.session_complete)
+      {
+        WrappedText(COLOR_OK, "Session complete - every step is done. Extra presses of End save "
+                              "extra captures.");
+      }
+      else
+      {
+        ColoredText(COLOR_TEXT, fmt::format("Step {} of {}:  {}", state.step_number,
+                                            state.step_count, state.step_label));
+        WrappedText(COLOR_TEXT, state.step_instruction);
+      }
+      if (state.capture_waiting)
+        ColoredText(COLOR_INFO, "Capturing...");
+      ColoredText(COLOR_DIM, fmt::format("Saved: {}   Saving: {}", state.captures_saved,
+                                         state.captures_saving));
+      ColoredText(COLOR_DIM, "End capture   PgDn skip   Del undo");
+    }
+    else if (state.watch.empty())
+    {
+      WrappedText(COLOR_TEXT, "No session.txt or watch.txt loaded. Put them in:");
+      WrappedText(COLOR_DIM, state.folder);
+      ColoredText(COLOR_DIM, "PgUp reload   End free capture");
+    }
+
+    if (!state.watch.empty())
+    {
+      ImGui::Separator();
+      for (const auto& [name, value] : state.watch)
+        ColoredText(COLOR_TEXT, fmt::format("{}: {}", name, value));
+      ColoredText(COLOR_DIM, state.recording ? "Ins stop recording" : "Ins record to CSV");
+    }
+
+    if (!state.status.empty())
+    {
+      ImGui::Separator();
+      const ImU32 color = state.status_kind == RoguelikeDev::StatusKind::Error ? COLOR_ERROR :
+                          state.status_kind == RoguelikeDev::StatusKind::Ok    ? COLOR_OK :
+                                                                                 COLOR_INFO;
+      WrappedText(color, state.status);
+    }
+
+    if (!state.file_errors.empty())
+    {
+      ImGui::Separator();
+      const std::size_t shown = std::min(state.file_errors.size(), MAX_ERRORS_SHOWN);
+      for (std::size_t i = 0; i < shown; ++i)
+        WrappedText(COLOR_ERROR, state.file_errors[i]);
+      if (state.file_errors.size() > shown)
+      {
+        ColoredText(COLOR_ERROR,
+                    fmt::format("...and {} more (see the log).", state.file_errors.size() - shown));
+      }
+    }
+
+    ColoredText(COLOR_DIM, "Home hide   PgUp reload files");
+    ImGui::PopTextWrapPos();
+  }
+  ImGui::End();
+
+  ImGui::PopStyleColor(2);
+  ImGui::PopStyleVar(3);
+  ImGui::PopFont();
+}
