+// ---------------------------------------------------------------------------------------------
+// CPU thread
+
+void DevTools::OnFrameEnd(Core::System& system)
+{
+  bool capture = false;
+  bool sample = false;
+  {
+    std::lock_guard lk(m_mutex);
+    EnsureLoadedLocked();
+    ++m_frame;
+
+    if (m_capture_requested)
+    {
+      if (std::chrono::steady_clock::now() - m_capture_request_time > CAPTURE_REQUEST_TIMEOUT)
+      {
+        m_capture_requested = false;
+        SetStatusLocked("Capture timed out - press again.", StatusKind::Error);
+      }
+      else
+      {
+        capture = true;
+      }
+    }
+
+    if (m_recording_wanted && !m_recording)
+      StartRecordingLocked();
+    else if (!m_recording_wanted && m_recording)
+    {
+      StopRecordingLocked();
+      SetStatusLocked("Watch recording saved to WatchLogs.", StatusKind::Ok);
+    }
+
+    sample = !m_watches.empty() && (m_visible || m_recording) &&
+             m_frame % WATCH_SAMPLE_INTERVAL == 0;
+  }
+
+  if (capture)
+    TakeCapture(system);
+  if (sample)
+    SampleWatches(system);
+}
+
+void DevTools::TakeCapture(Core::System& system)
+{
+  auto& memory = system.GetMemory();
+  const bool is_wii = system.IsWii();
+  const u8* mem1 = memory.GetRAM();
+  const std::uint32_t mem1_size = mem1 ? memory.GetRamSizeReal() : 0;
+  const u8* mem2 = is_wii ? memory.GetEXRAM() : nullptr;
+  const std::uint32_t mem2_size = mem2 ? memory.GetExRamSizeReal() : 0;
+
+  std::shared_ptr<Session> session;
+  std::size_t entry_index = 0;
+  std::string game_id = SConfig::GetInstance().GetGameID();
+  std::uint64_t frame = 0;
+  {
+    std::lock_guard lk(m_mutex);
+    if (!m_capture_requested)
+      return;  // cancelled meanwhile
+    m_capture_requested = false;
+
+    if (mem1_size == 0)
+    {
+      SetStatusLocked("No game memory to capture.", StatusKind::Error);
+      return;
+    }
+    if (m_captures_in_flight >= MAX_CAPTURES_IN_FLIGHT)
+    {
+      SetStatusLocked("Still saving the last capture - press again in a moment.",
+                      StatusKind::Error);
+      return;
+    }
+    if (!EnsureSessionDirLocked())
+      return;
+
+    // The request was made for this step; undo/skip since then cancel it, so they still match.
+    const std::size_t step_index = m_capture_request_step;
+    const bool in_script = step_index < m_session->steps.size();
+
+    Entry entry;
+    entry.index = static_cast<int>(m_session->entries.size()) + 1;
+    entry.step = in_script ? static_cast<int>(step_index) : -1;
+    if (in_script)
+    {
+      entry.label = m_session->steps[step_index].label;
+      entry.instruction = m_session->steps[step_index].instruction;
+    }
+    else
+    {
+      entry.label = "extra";
+      entry.instruction = "Capture after the end of the session.";
+    }
+    entry.file = fmt::format("{:03}_{}.snap.zst", entry.index, entry.label);
+    entry.status = EntryStatus::Saving;
+    entry.game_id = game_id;
+    entry.frame = m_frame;
+    entry.time = LocalTimeString("%Y-%m-%dT%H:%M:%S");
+    entry.mem1_size = mem1_size;
+    entry.mem2_size = mem2_size;
+    frame = m_frame;
+
+    m_session->entries.push_back(std::move(entry));
+    entry_index = m_session->entries.size() - 1;
+    m_history.push_back({true, in_script ? static_cast<int>(step_index) : -1, entry_index});
+    if (in_script)
+      m_step = step_index + 1;
+    ++m_captures_in_flight;
+    session = m_session;
+  }
+
+  // Copy memory outside the lock. Only this (CPU) thread writes emulated memory, so the snapshot
+  // is consistent.
+  Job job;
+  job.kind = Job::Kind::Capture;
+  job.session = session;
+  job.entry = entry_index;
+  job.size = SNAPSHOT_HEADER_SIZE + std::size_t{mem1_size} + mem2_size;
+  // Exceptions are disabled in Dolphin builds, so allocate without throwing.
+  job.data.reset(new (std::nothrow) std::uint8_t[job.size]);
+  const bool ok = job.data != nullptr;
+
+  if (ok)
+  {
+    std::uint8_t* out = job.data.get();
+    const auto header = MakeSnapshotHeader(mem1_size, mem2_size, frame, game_id);
+    std::memcpy(out, header.data(), header.size());
+    std::memcpy(out + SNAPSHOT_HEADER_SIZE, mem1, mem1_size);
+    if (mem2_size != 0)
+      std::memcpy(out + SNAPSHOT_HEADER_SIZE + mem1_size, mem2, mem2_size);
+  }
+
+  std::lock_guard lk(m_mutex);
+  Entry& entry = session->entries[entry_index];
+  if (!ok)
+  {
+    --m_captures_in_flight;
+    if (entry.status != EntryStatus::Discarded)
+    {
+      entry.status = EntryStatus::Failed;
+      entry.error = "Out of memory while copying.";
+    }
+    SetStatusLocked("Capture failed: out of memory.", StatusKind::Error);
+    QueueManifestLocked();
+    return;
+  }
+  SetStatusLocked(fmt::format("Captured '{}' - saving...", entry.label), StatusKind::Info);
+  QueueJobLocked(std::move(job));
+}
+
+void DevTools::SampleWatches(Core::System& system)
+{
+  std::vector<WatchEntry> watches;
+  {
+    std::lock_guard lk(m_mutex);
+    watches = m_watches;
+  }
+
+  auto& memory = system.GetMemory();
+  const std::uint32_t mem1_size = memory.GetRAM() ? memory.GetRamSizeReal() : 0;
+  const std::uint32_t mem2_size =
+      (system.IsWii() && memory.GetEXRAM()) ? memory.GetExRamSizeReal() : 0;
+
+  std::vector<std::string> display(watches.size());
+  std::vector<std::string> csv(watches.size());
+  {
+    const Core::CPUThreadGuard guard(system);
+    for (std::size_t i = 0; i < watches.size(); ++i)
+    {
+      const WatchEntry& watch = watches[i];
+      std::uint32_t address = watch.base;
+      bool valid = true;
+      for (const std::int64_t offset : watch.offsets)
+      {
+        if (!IsRamRange(address, 4, mem1_size, mem2_size))
+        {
+          valid = false;
+          break;
+        }
+        const auto pointer = PowerPC::MMU::HostTryRead<u32>(guard, address);
+        if (!pointer)
+        {
+          valid = false;
+          break;
+        }
+        address = static_cast<std::uint32_t>(static_cast<std::int64_t>(pointer->value) + offset);
+      }
+
+      const std::size_t size = WatchTypeSize(watch.type);
+      if (!valid || !IsRamRange(address, size, mem1_size, mem2_size))
+      {
+        display[i] = "??";
+        continue;
+      }
+
+      std::optional<std::uint64_t> raw;
+      switch (size)
+      {
+      case 1:
+        if (const auto r = PowerPC::MMU::HostTryRead<u8>(guard, address))
+          raw = r->value;
+        break;
+      case 2:
+        if (const auto r = PowerPC::MMU::HostTryRead<u16>(guard, address))
+          raw = r->value;
+        break;
+      case 8:
+        if (const auto r = PowerPC::MMU::HostTryRead<u64>(guard, address))
+          raw = r->value;
+        break;
+      default:
+        if (const auto r = PowerPC::MMU::HostTryRead<u32>(guard, address))
+          raw = r->value;
+        break;
+      }
+      if (!raw)
+      {
+        display[i] = "??";
+        continue;
+      }
+      csv[i] = FormatWatchValue(watch.type, *raw);
+      display[i] = watch.offsets.empty() ? csv[i] : fmt::format("{}  @{:08X}", csv[i], address);
+    }
+  }
+
+  std::lock_guard lk(m_mutex);
+  // The list may have been reloaded while sampling; only publish matching results.
+  if (m_watches.size() != watches.size())
+    return;
+  m_watch_values = std::move(display);
+  m_watch_csv_values = csv;
+
+  if (m_recording && m_csv.IsOpen())
+  {
+    const double seconds =
+        std::chrono::duration<double>(std::chrono::steady_clock::now() - m_recording_start)
+            .count();
+    std::string row = fmt::format("{},{:.3f}", m_frame, seconds);
+    for (const std::string& value : csv)
+      row += "," + CsvEscape(value);
+    row += "\n";
+    if (!m_csv.WriteString(row))
+    {
+      SetStatusLocked("Couldn't write the watch recording.", StatusKind::Error);
+      StopRecordingLocked();
+      m_recording_wanted = false;
+      return;
+    }
+    if (++m_csv_rows_since_flush >= CSV_FLUSH_INTERVAL)
+    {
+      m_csv.Flush();
+      m_csv_rows_since_flush = 0;
+    }
+  }
+}
+
+void DevTools::StartRecordingLocked()
+{
+  const std::string dir = GetFolder() + "WatchLogs" DIR_SEP;
+  File::CreateFullPath(dir);
+  const std::string path = dir + "watch_" + LocalTimeString("%Y%m%d-%H%M%S") + ".csv";
+  if (!m_csv.Open(path, "wb"))
+  {
+    SetStatusLocked("Couldn't create the watch recording file.", StatusKind::Error);
+    m_recording_wanted = false;
+    return;
+  }
+
+  std::string header = "frame,seconds";
+  for (const WatchEntry& watch : m_watches)
+    header += "," + CsvEscape(watch.name);
+  header += "\n";
+  m_csv.WriteString(header);
+
+  m_recording = true;
+  m_csv_rows_since_flush = 0;
+  m_recording_start = std::chrono::steady_clock::now();
+  SetStatusLocked("Recording watch values.", StatusKind::Ok);
+}
+
+void DevTools::StopRecordingLocked()
+{
+  if (!m_recording)
+    return;
+  m_recording = false;
+  m_csv.Flush();
+  m_csv.Close();
+}
+
+// ---------------------------------------------------------------------------------------------
+// Shared helpers
+
+void DevTools::SetStatusLocked(std::string text, StatusKind kind)
+{
+  m_status = text;
+  m_status_kind = kind;
+  // While shutting down, the on-screen display and logging may already be gone.
+  if (m_stop)
+    return;
+  if (kind == StatusKind::Error)
+    WARN_LOG_FMT(CORE, "Roguelike dev tools: {}", text);
+  OSD::AddMessage("Dev tools: " + text, OSD::Duration::NORMAL,
+                  kind == StatusKind::Error ? OSD::Color::RED :
+                  kind == StatusKind::Ok    ? OSD::Color::GREEN :
+                                              OSD::Color::CYAN);
+}
+
+void DevTools::QueueJobLocked(Job job)
+{
+  m_jobs.push_back(std::move(job));
+  m_jobs_cv.notify_one();
+}
+
+void DevTools::QueueManifestLocked()
+{
+  for (const Job& job : m_jobs)
+  {
+    if (job.kind == Job::Kind::Manifest && job.session == m_session)
+      return;
+  }
+  Job job;
+  job.kind = Job::Kind::Manifest;
+  job.session = m_session;
+  QueueJobLocked(std::move(job));
+}
+
+int DevTools::CountEntriesLocked(EntryStatus status) const
+{
+  if (!m_session)
+    return 0;
+  return static_cast<int>(std::count_if(m_session->entries.begin(), m_session->entries.end(),
+                                        [status](const Entry& e) { return e.status == status; }));
+}
+
+// ---------------------------------------------------------------------------------------------
+// Worker thread
+
+void DevTools::WorkerLoop()
+{
+  while (true)
+  {
+    Job job;
+    {
+      std::unique_lock lk(m_mutex);
+      m_jobs_cv.wait(lk, [this] { return m_stop || !m_jobs.empty(); });
+      if (m_jobs.empty())
+        return;  // stop requested and nothing left to write
+      job = std::move(m_jobs.front());
+      m_jobs.pop_front();
+    }
+    RunJob(job);
+  }
+}
+
+void DevTools::RunJob(Job& job)
+{
+  switch (job.kind)
+  {
+  case Job::Kind::Delete:
+    File::Delete(job.path, File::IfAbsentBehavior::NoConsoleWarning);
+    WriteManifest(job.session);
+    return;
+
+  case Job::Kind::Manifest:
+    WriteManifest(job.session);
+    return;
+
+  case Job::Kind::Capture:
+    break;
+  }
+
+  std::string path;
+  {
+    std::lock_guard lk(m_mutex);
+    path = job.session->dir + job.session->entries[job.entry].file;
+  }
+
+  std::string error;
+  std::uint64_t written = 0;
+  const std::size_t bound = ZSTD_compressBound(job.size);
+  std::unique_ptr<std::uint8_t[]> compressed(new (std::nothrow) std::uint8_t[bound]);
+  if (!compressed)
+    error = "Out of memory while compressing.";
+
+  if (error.empty())
+  {
+    const std::size_t size =
+        ZSTD_compress(compressed.get(), bound, job.data.get(), job.size, ZSTD_LEVEL);
+    if (ZSTD_isError(size))
+    {
+      error = fmt::format("Compression failed: {}", ZSTD_getErrorName(size));
+    }
+    else
+    {
+      job.data.reset();
+      const std::string temp = path + ".tmp";
+      File::IOFile file(temp, "wb");
+      const bool wrote = file.IsOpen() && file.WriteBytes(compressed.get(), size) && file.Flush();
+      file.Close();
+      if (!wrote)
+      {
+        File::Delete(temp, File::IfAbsentBehavior::NoConsoleWarning);
+        error = "Couldn't write the file (disk full?).";
+      }
+      else if (!File::Rename(temp, path))
+      {
+        File::Delete(temp, File::IfAbsentBehavior::NoConsoleWarning);
+        error = "Couldn't rename the file.";
+      }
+      else
+      {
+        written = size;
+      }
+    }
+  }
+
+  bool delete_file = false;
+  {
+    std::lock_guard lk(m_mutex);
+    --m_captures_in_flight;
+    Entry& entry = job.session->entries[job.entry];
+    if (entry.status == EntryStatus::Discarded)
+    {
+      delete_file = error.empty();
+    }
+    else if (!error.empty())
+    {
+      entry.status = EntryStatus::Failed;
+      entry.error = error;
+      SetStatusLocked(fmt::format("Capture '{}' failed: {}", entry.label, error),
+                      StatusKind::Error);
+    }
+    else
+    {
+      entry.status = EntryStatus::Saved;
+      entry.bytes = written;
+      SetStatusLocked(fmt::format("Saved '{}' ({:.1f} MB).", entry.label,
+                                  static_cast<double>(written) / (1024.0 * 1024.0)),
+                      StatusKind::Ok);
+    }
+  }
+
+  if (delete_file)
+    File::Delete(path, File::IfAbsentBehavior::NoConsoleWarning);
+  WriteManifest(job.session);
+}
+
+void DevTools::WriteManifest(const std::shared_ptr<Session>& session)
+{
+  std::string json;
+  std::string path;
+  {
+    std::lock_guard lk(m_mutex);
+    if (!session || session->dir.empty())
+      return;
+    path = session->dir + "manifest.json";
+
+    json = "{\n";
+    json += "  \"tool\": \"Skylanders roguelike dev tools\",\n";
+    json += fmt::format("  \"format\": {},\n", SNAPSHOT_VERSION);
+    json += fmt::format("  \"title\": \"{}\",\n", JsonEscape(session->title));
+    json += fmt::format("  \"started\": \"{}\",\n", JsonEscape(session->started));
+    json += fmt::format("  \"snapshot_header_size\": {},\n", SNAPSHOT_HEADER_SIZE);
+    json += "  \"steps\": [\n";
+    for (std::size_t i = 0; i < session->steps.size(); ++i)
+    {
+      json += fmt::format("    {{\"step\": {}, \"label\": \"{}\", \"instruction\": \"{}\"}}{}\n",
+                          i + 1, JsonEscape(session->steps[i].label),
+                          JsonEscape(session->steps[i].instruction),
+                          i + 1 < session->steps.size() ? "," : "");
+    }
+    json += "  ],\n";
+    json += "  \"entries\": [\n";
+    for (std::size_t i = 0; i < session->entries.size(); ++i)
+    {
+      const Entry& e = session->entries[i];
+      json += "    {";
+      json += fmt::format("\"index\": {}, ", e.index);
+      json += fmt::format("\"step\": {}, ", e.step >= 0 ? e.step + 1 : 0);
+      json += fmt::format("\"label\": \"{}\", ", JsonEscape(e.label));
+      json += fmt::format("\"status\": \"{}\", ", StatusName(static_cast<int>(e.status)));
+      json += fmt::format("\"file\": \"{}\", ", JsonEscape(e.file));
+      json += fmt::format("\"game_id\": \"{}\", ", JsonEscape(e.game_id));
+      json += fmt::format("\"frame\": {}, ", e.frame);
+      json += fmt::format("\"time\": \"{}\", ", JsonEscape(e.time));
+      json += fmt::format("\"mem1_size\": {}, \"mem2_size\": {}, ", e.mem1_size, e.mem2_size);
+      json += fmt::format("\"bytes\": {}, ", e.bytes);
+      json += fmt::format("\"error\": \"{}\"", JsonEscape(e.error));
+      json += fmt::format("}}{}\n", i + 1 < session->entries.size() ? "," : "");
+    }
+    json += "  ]\n}\n";
+  }
+
+  const std::string temp = path + ".tmp";
+  if (!File::WriteStringToFile(temp, json) || !File::Rename(temp, path))
+  {
+    File::Delete(temp, File::IfAbsentBehavior::NoConsoleWarning);
+    std::lock_guard lk(m_mutex);
+    SetStatusLocked("Couldn't write manifest.json.", StatusKind::Error);
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Video thread
+
+OverlayState DevTools::GetOverlayState()
+{
+  std::lock_guard lk(m_mutex);
+  OverlayState state;
+  state.visible = m_visible;
+  if (!m_visible)
+    return state;
+
+  state.folder = GetFolder();
+  state.file_errors = m_file_errors;
+  state.status = m_status;
+  state.status_kind = m_status_kind;
+  state.capture_waiting = m_capture_requested;
+  state.captures_saved = CountEntriesLocked(EntryStatus::Saved);
+  state.captures_saving = m_captures_in_flight;
+  state.recording = m_recording;
+
+  if (m_session && !m_session->steps.empty())
+  {
+    state.has_session = true;
+    state.session_title = m_session->title;
+    state.step_count = static_cast<int>(m_session->steps.size());
+    state.step_number = static_cast<int>(m_step) + 1;
+    state.session_complete = m_step >= m_session->steps.size();
+    if (!state.session_complete)
+    {
+      state.step_label = m_session->steps[m_step].label;
+      state.step_instruction = m_session->steps[m_step].instruction;
+    }
+  }
+
+  state.watch.reserve(m_watches.size());
+  for (std::size_t i = 0; i < m_watches.size(); ++i)
+    state.watch.emplace_back(m_watches[i].name, i < m_watch_values.size() ? m_watch_values[i] : "-");
+  return state;
+}
+}  // namespace RoguelikeDev
diff --git a/Source/Core/Core/RoguelikeDev/DevTools.h b/Source/Core/Core/RoguelikeDev/DevTools.h
new file mode 100644
index 0000000..b28e6de
--- /dev/null
+++ b/Source/Core/Core/RoguelikeDev/DevTools.h
@@ -0,0 +1,209 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Research tools for the Skylanders roguelike build.
+//
+// Guided capture sessions: session.txt lists steps ("get hit once, then press End"). Each press
+// saves a compressed snapshot of MEM1 + MEM2 plus a manifest entry, so memory addresses can be
+// found offline by comparing snapshots. Watch list: watch.txt lists addresses (optionally through
+// pointer chains) to show live on screen and to record to CSV.
+//
+// Threads: hotkeys call the request functions, the CPU thread calls OnFrameEnd (memory is only
+// read there), a worker thread compresses and writes files, and the video thread reads
+// GetOverlayState.
+
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "Common/IOFile.h"
+#include "Core/RoguelikeDev/DevToolsParse.h"
+
+namespace Core
+{
+class System;
+}
+
+namespace RoguelikeDev
+{
+enum class StatusKind
+{
+  Info,
+  Ok,
+  Error,
+};
+
+struct OverlayState
+{
+  bool visible = false;
+  std::string folder;
+
+  bool has_session = false;
+  std::string session_title;
+  int step_number = 0;  // 1-based; step_count + 1 once complete
+  int step_count = 0;
+  std::string step_label;
+  std::string step_instruction;
+  bool session_complete = false;
+  bool capture_waiting = false;
+
+  int captures_saved = 0;
+  int captures_saving = 0;
+
+  std::string status;
+  StatusKind status_kind = StatusKind::Info;
+
+  bool recording = false;
+  std::vector<std::pair<std::string, std::string>> watch;  // name, formatted value
+
+  std::vector<std::string> file_errors;
+};
+
+class DevTools
+{
+public:
+  static DevTools& GetInstance();
+
+  DevTools(const DevTools&) = delete;
+  DevTools& operator=(const DevTools&) = delete;
+
+  // Hotkey thread. Capture/Undo/Skip/ToggleRecording expect the game to be running.
+  void RequestCapture();
+  void Undo();
+  void Skip();
+  void ToggleOverlay();
+  void ToggleRecording();
+  void ReloadFiles();
+
+  // CPU thread, once per emulated frame.
+  void OnFrameEnd(Core::System& system);
+
+  // Video thread.
+  OverlayState GetOverlayState();
+
+  static std::string GetFolder();
+
+private:
+  enum class EntryStatus
+  {
+    Saving,
+    Saved,
+    Failed,
+    Skipped,
+    Discarded,
+  };
+
+  struct Entry
+  {
+    int index = 0;  // 1-based capture number within the session
+    int step = -1;  // 0-based step, -1 for a capture after the script ended
+    std::string label;
+    std::string instruction;
+    std::string file;  // empty for skipped steps
+    EntryStatus status = EntryStatus::Saving;
+    std::string game_id;
+    std::uint64_t frame = 0;
+    std::string time;
+    std::uint64_t bytes = 0;
+    std::uint32_t mem1_size = 0;
+    std::uint32_t mem2_size = 0;
+    std::string error;
+  };
+
+  struct Session
+  {
+    std::string title;
+    std::vector<SessionStep> steps;
+    std::string dir;  // empty until the first capture or skip
+    std::string started;
+    std::vector<Entry> entries;
+  };
+
+  struct Action
+  {
+    bool is_capture = false;
+    int step = -1;
+    std::size_t entry = 0;
+  };
+
+  struct Job
+  {
+    enum class Kind
+    {
+      Capture,
+      Delete,
+      Manifest,
+    };
+    Kind kind = Kind::Manifest;
+    std::shared_ptr<Session> session;
+    std::size_t entry = 0;
+    std::unique_ptr<std::uint8_t[]> data;
+    std::size_t size = 0;
+    std::string path;
+  };
+
+  DevTools();
+  ~DevTools();
+
+  // All of these expect m_mutex to be held.
+  void EnsureLoadedLocked();
+  void LoadFilesLocked();
+  void StartSessionLocked();
+  bool EnsureSessionDirLocked();
+  void SetStatusLocked(std::string text, StatusKind kind);
+  void QueueJobLocked(Job job);
+  void QueueManifestLocked();
+  int CountEntriesLocked(EntryStatus status) const;
+
+  void TakeCapture(Core::System& system);
+  void SampleWatches(Core::System& system);
+  void StartRecordingLocked();
+  void StopRecordingLocked();
+
+  void WorkerLoop();
+  void RunJob(Job& job);
+  void WriteManifest(const std::shared_ptr<Session>& session);
+
+  mutable std::mutex m_mutex;
+
+  bool m_loaded = false;
+  bool m_visible = false;
+  std::vector<std::string> m_file_errors;
+
+  std::shared_ptr<Session> m_session;
+  std::size_t m_step = 0;
+  std::vector<Action> m_history;
+
+  bool m_capture_requested = false;
+  std::size_t m_capture_request_step = 0;
+  std::chrono::steady_clock::time_point m_capture_request_time;
+
+  std::vector<WatchEntry> m_watches;
+  std::vector<std::string> m_watch_values;
+  std::vector<std::string> m_watch_csv_values;
+  bool m_recording_wanted = false;
+  bool m_recording = false;
+  File::IOFile m_csv;
+  int m_csv_rows_since_flush = 0;
+  std::uint64_t m_frame = 0;
+  std::chrono::steady_clock::time_point m_recording_start;
+
+  std::string m_status;
+  StatusKind m_status_kind = StatusKind::Info;
+
+  // Worker
+  std::deque<Job> m_jobs;
+  int m_captures_in_flight = 0;
+  std::condition_variable m_jobs_cv;
+  bool m_stop = false;
+  std::thread m_worker;
+};
+}  // namespace RoguelikeDev
diff --git a/Source/Core/Core/RoguelikeDev/DevToolsParse.cpp b/Source/Core/Core/RoguelikeDev/DevToolsParse.cpp
new file mode 100644
index 0000000..f810e27
--- /dev/null
+++ b/Source/Core/Core/RoguelikeDev/DevToolsParse.cpp
@@ -0,0 +1,462 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Core/RoguelikeDev/DevToolsParse.h"
+
+#include <array>
+#include <bit>
+#include <cctype>
+#include <charconv>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+namespace RoguelikeDev
+{
+namespace
+{
+constexpr std::string_view UTF8_BOM = "\xEF\xBB\xBF";
+
+// Splits into lines, accepting \n, \r\n and lone \r. Strips a leading UTF-8 BOM.
+std::vector<std::string_view> SplitLines(std::string_view text)
+{
+  if (text.starts_with(UTF8_BOM))
+    text.remove_prefix(UTF8_BOM.size());
+
+  std::vector<std::string_view> lines;
+  std::size_t start = 0;
+  for (std::size_t i = 0; i < text.size(); ++i)
+  {
+    if (text[i] == '\n' || text[i] == '\r')
+    {
+      lines.push_back(text.substr(start, i - start));
+      if (text[i] == '\r' && i + 1 < text.size() && text[i + 1] == '\n')
+        ++i;
+      start = i + 1;
+    }
+  }
+  if (start < text.size())
+    lines.push_back(text.substr(start));
+  return lines;
+}
+
+std::vector<std::string_view> Split(std::string_view text, char separator)
+{
+  std::vector<std::string_view> parts;
+  std::size_t start = 0;
+  while (true)
+  {
+    const std::size_t pos = text.find(separator, start);
+    if (pos == std::string_view::npos)
+    {
+      parts.push_back(text.substr(start));
+      return parts;
+    }
+    parts.push_back(text.substr(start, pos - start));
+    start = pos + 1;
+  }
+}
+
+bool IsSpace(char c)
+{
+  return c == ' ' || c == '\t' || c == '\v' || c == '\f';
+}
+
+char ToLowerAscii(char c)
+{
+  return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c;
+}
+
+std::string ToLower(std::string_view text)
+{
+  std::string out(text);
+  for (char& c : out)
+    c = ToLowerAscii(c);
+  return out;
+}
+
+bool IsCommentOrBlank(std::string_view line)
+{
+  return line.empty() || line.front() == '#';
+}
+
+// Parses an unsigned number in decimal or 0x-prefixed hex. The whole string must be consumed.
+std::optional<std::uint64_t> ParseUnsigned(std::string_view text)
+{
+  text = Trim(text);
+  if (text.empty())
+    return std::nullopt;
+
+  int base = 10;
+  if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X'))
+  {
+    base = 16;
+    text.remove_prefix(2);
+  }
+  else if (text.size() > 1 && (text[0] == '$'))
+  {
+    base = 16;
+    text.remove_prefix(1);
+  }
+
+  std::uint64_t value = 0;
+  const auto [ptr, ec] = std::from_chars(text.data(), text.data() + text.size(), value, base);
+  if (ec != std::errc() || ptr != text.data() + text.size())
+    return std::nullopt;
+  return value;
+}
+
+std::optional<WatchType> ParseWatchType(std::string_view text)
+{
+  static constexpr std::array<std::pair<std::string_view, WatchType>, 13> types{{
+      {"u8", WatchType::U8},
+      {"u16", WatchType::U16},
+      {"u32", WatchType::U32},
+      {"s8", WatchType::S8},
+      {"s16", WatchType::S16},
+      {"s32", WatchType::S32},
+      {"i8", WatchType::S8},
+      {"i16", WatchType::S16},
+      {"i32", WatchType::S32},
+      {"f32", WatchType::F32},
+      {"float", WatchType::F32},
+      {"f64", WatchType::F64},
+      {"hex", WatchType::Hex32},
+  }};
+  const std::string lower = ToLower(Trim(text));
+  for (const auto& [name, type] : types)
+  {
+    if (lower == name)
+      return type;
+  }
+  if (lower == "hex32" || lower == "x32")
+    return WatchType::Hex32;
+  if (lower == "double")
+    return WatchType::F64;
+  return std::nullopt;
+}
+
+std::string FormatFloating(double value)
+{
+  if (std::isnan(value))
+    return "NaN";
+  if (std::isinf(value))
+    return value > 0 ? "inf" : "-inf";
+  std::array<char, 64> buffer{};
+  std::snprintf(buffer.data(), buffer.size(), "%.6g", value);
+  return buffer.data();
+}
+}  // namespace
+
+std::string_view Trim(std::string_view text)
+{
+  while (!text.empty() && IsSpace(text.front()))
+    text.remove_prefix(1);
+  while (!text.empty() && IsSpace(text.back()))
+    text.remove_suffix(1);
+  return text;
+}
+
+std::optional<std::uint32_t> ParseAddress(std::string_view text)
+{
+  const auto value = ParseUnsigned(text);
+  if (!value || *value > std::numeric_limits<std::uint32_t>::max())
+    return std::nullopt;
+  return static_cast<std::uint32_t>(*value);
+}
+
+std::optional<std::int64_t> ParseOffset(std::string_view text)
+{
+  text = Trim(text);
+  bool negative = false;
+  if (!text.empty() && (text.front() == '-' || text.front() == '+'))
+  {
+    negative = text.front() == '-';
+    text.remove_prefix(1);
+  }
+  const auto value = ParseUnsigned(text);
+  if (!value || *value > 0x7FFFFFFFull)
+    return std::nullopt;
+  const auto signed_value = static_cast<std::int64_t>(*value);
+  return negative ? -signed_value : signed_value;
+}
+
+std::string SanitizeLabel(std::string_view text)
+{
+  std::string out;
+  bool last_was_underscore = false;
+  for (const char raw : Trim(text))
+  {
+    const char c = ToLowerAscii(raw);
+    if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')
+    {
+      out.push_back(c);
+      last_was_underscore = false;
+    }
+    else if ((c == '_' || IsSpace(c) || c == '.' || c == '/') && !out.empty() &&
+             !last_was_underscore)
+    {
+      out.push_back('_');
+      last_was_underscore = true;
+    }
+    if (out.size() >= MAX_LABEL_LENGTH)
+      break;
+  }
+  while (!out.empty() && out.back() == '_')
+    out.pop_back();
+  return out;
+}
+
+SessionScript ParseSessionScript(std::string_view text)
+{
+  SessionScript script;
+  int line_number = 0;
+  for (std::string_view raw_line : SplitLines(text))
+  {
+    ++line_number;
+    const std::string_view line = Trim(raw_line);
+    if (IsCommentOrBlank(line))
+      continue;
+
+    const std::string lower = ToLower(line.substr(0, 6));
+    if (lower == "title:")
+    {
+      script.title = std::string(Trim(line.substr(6)));
+      continue;
+    }
+
+    if (script.steps.size() >= MAX_SESSION_STEPS)
+    {
+      script.errors.push_back({line_number, "Too many steps; the rest are ignored."});
+      break;
+    }
+
+    SessionStep step;
+    const std::size_t bar = line.find('|');
+    const std::size_t step_number = script.steps.size() + 1;
+    if (bar == std::string_view::npos)
+    {
+      step.instruction = std::string(line);
+    }
+    else
+    {
+      step.label = SanitizeLabel(line.substr(0, bar));
+      step.instruction = std::string(Trim(line.substr(bar + 1)));
+    }
+    if (step.label.empty())
+      step.label = "step_" + std::to_string(step_number);
+    if (step.instruction.empty())
+    {
+      script.errors.push_back({line_number, "Step has no instruction."});
+      step.instruction = "(no instruction)";
+    }
+    script.steps.push_back(std::move(step));
+  }
+  return script;
+}
+
+WatchList ParseWatchList(std::string_view text)
+{
+  WatchList list;
+  int line_number = 0;
+  for (std::string_view raw_line : SplitLines(text))
+  {
+    ++line_number;
+    const std::string_view line = Trim(raw_line);
+    if (IsCommentOrBlank(line))
+      continue;
+
+    if (list.entries.size() >= MAX_WATCH_ENTRIES)
+    {
+      list.errors.push_back({line_number, "Too many watches; the rest are ignored."});
+      break;
+    }
+
+    const auto fields = Split(line, '|');
+    if (fields.size() != 3)
+    {
+      list.errors.push_back({line_number, "Expected: name | type | address"});
+      continue;
+    }
+
+    WatchEntry entry;
+    entry.name = std::string(Trim(fields[0]));
+    if (entry.name.empty())
+    {
+      list.errors.push_back({line_number, "Missing name."});
+      continue;
+    }
+    if (entry.name.size() > MAX_NAME_LENGTH)
+      entry.name.resize(MAX_NAME_LENGTH);
+
+    const auto type = ParseWatchType(fields[1]);
+    if (!type)
+    {
+      list.errors.push_back({line_number, "Unknown type (use u8 u16 u32 s8 s16 s32 f32 f64 hex)."});
+      continue;
+    }
+    entry.type = *type;
+
+    const auto path = Split(fields[2], '>');
+    const auto base = ParseAddress(path[0]);
+    if (!base)
+    {
+      list.errors.push_back({line_number, "Bad address."});
+      continue;
+    }
+    entry.base = *base;
+
+    bool ok = true;
+    for (std::size_t i = 1; i < path.size(); ++i)
+    {
+      const auto offset = ParseOffset(path[i]);
+      if (!offset)
+      {
+        list.errors.push_back({line_number, "Bad pointer offset."});
+        ok = false;
+        break;
+      }
+      entry.offsets.push_back(*offset);
+    }
+    if (!ok)
+      continue;
+    if (entry.offsets.size() > MAX_WATCH_OFFSETS)
+    {
+      list.errors.push_back({line_number, "Too many pointer offsets."});
+      continue;
+    }
+
+    list.entries.push_back(std::move(entry));
+  }
+  return list;
+}
+
+std::size_t WatchTypeSize(WatchType type)
+{
+  switch (type)
+  {
+  case WatchType::U8:
+  case WatchType::S8:
+    return 1;
+  case WatchType::U16:
+  case WatchType::S16:
+    return 2;
+  case WatchType::F64:
+    return 8;
+  case WatchType::U32:
+  case WatchType::S32:
+  case WatchType::F32:
+  case WatchType::Hex32:
+    return 4;
+  }
+  return 4;
+}
+
+std::string FormatWatchValue(WatchType type, std::uint64_t raw)
+{
+  switch (type)
+  {
+  case WatchType::U8:
+    return std::to_string(static_cast<std::uint8_t>(raw));
+  case WatchType::U16:
+    return std::to_string(static_cast<std::uint16_t>(raw));
+  case WatchType::U32:
+    return std::to_string(static_cast<std::uint32_t>(raw));
+  case WatchType::S8:
+    return std::to_string(static_cast<std::int8_t>(static_cast<std::uint8_t>(raw)));
+  case WatchType::S16:
+    return std::to_string(static_cast<std::int16_t>(static_cast<std::uint16_t>(raw)));
+  case WatchType::S32:
+    return std::to_string(static_cast<std::int32_t>(static_cast<std::uint32_t>(raw)));
+  case WatchType::F32:
+    return FormatFloating(std::bit_cast<float>(static_cast<std::uint32_t>(raw)));
+  case WatchType::F64:
+    return FormatFloating(std::bit_cast<double>(raw));
+  case WatchType::Hex32:
+  {
+    std::array<char, 16> buffer{};
+    std::snprintf(buffer.data(), buffer.size(), "0x%08X", static_cast<unsigned>(raw & 0xFFFFFFFFu));
+    return buffer.data();
+  }
+  }
+  return "?";
+}
+
+std::array<std::uint8_t, SNAPSHOT_HEADER_SIZE> MakeSnapshotHeader(std::uint32_t mem1_size,
+                                                                  std::uint32_t mem2_size,
+                                                                  std::uint64_t frame,
+                                                                  std::string_view game_id)
+{
+  std::array<std::uint8_t, SNAPSHOT_HEADER_SIZE> header{};
+  const auto put = [&header](std::size_t offset, std::uint64_t value, int bytes) {
+    for (int i = 0; i < bytes; ++i)
+      header[offset + i] = static_cast<std::uint8_t>(value >> (8 * i));
+  };
+  constexpr std::string_view magic = "SKRLSNAP";
+  for (std::size_t i = 0; i < magic.size(); ++i)
+    header[i] = static_cast<std::uint8_t>(magic[i]);
+  put(8, SNAPSHOT_VERSION, 4);
+  put(12, SNAPSHOT_HEADER_SIZE, 4);
+  put(16, mem1_size, 4);
+  put(20, mem2_size, 4);
+  put(24, frame, 8);
+  for (std::size_t i = 0; i < game_id.size() && i < 16; ++i)
+    header[32 + i] = static_cast<std::uint8_t>(game_id[i]);
+  return header;
+}
+
+std::string JsonEscape(std::string_view text)
+{
+  std::string out;
+  out.reserve(text.size() + 8);
+  for (const char c : text)
+  {
+    switch (c)
+    {
+    case '"':
+      out += "\\\"";
+      break;
+    case '\\':
+      out += "\\\\";
+      break;
+    case '\n':
+      out += "\\n";
+      break;
+    case '\r':
+      out += "\\r";
+      break;
+    case '\t':
+      out += "\\t";
+      break;
+    default:
+      if (static_cast<unsigned char>(c) < 0x20)
+      {
+        std::array<char, 8> buffer{};
+        std::snprintf(buffer.data(), buffer.size(), "\\u%04x", static_cast<unsigned>(c));
+        out += buffer.data();
+      }
+      else
+      {
+        out.push_back(c);
+      }
+    }
+  }
+  return out;
+}
+
+std::string CsvEscape(std::string_view text)
+{
+  if (text.find_first_of(",\"\r\n") == std::string_view::npos)
+    return std::string(text);
+  std::string out = "\"";
+  for (const char c : text)
+  {
+    if (c == '"')
+      out += "\"\"";
+    else
+      out.push_back(c);
+  }
+  out += '"';
+  return out;
+}
+}  // namespace RoguelikeDev
